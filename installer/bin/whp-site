#!/usr/bin/env bash
# Manage websites: own Linux user, own PHP-FPM pool (any installed PHP
# version), Nginx vhost with page cache, automatic Let's Encrypt.
# The panel agent calls this tool; it can also be used by hand.
#
#   whp-site add <domain> [--php 8.4] [--alias www.<domain>] [--profile php|wordpress|laravel]
#                         [--docroot public] [--no-cache] [--no-ssl] [--parent <domain>] [--json]
#                                    (--parent: a subdomain like test.example.com of the site
#                                     example.com: own user, PHP pool, vhost and certificate,
#                                     but it shares the disk quota of its parent site)
#   whp-site subdomains <domain>     (the subdomain sites of a site, one per line)
#   whp-site php <domain> <version>
#   whp-site cache <domain> on|off|purge
#   whp-site ssl <domain> | --pending
#   whp-site ssl <domain> --import-cert <fullchain.pem> --import-key <key.pem>
#                                    (serve a certificate taken over from another server,
#                                     SSL becomes 'imported' until Let's Encrypt succeeds)
#   whp-site ssl <domain> --custom-cert <cert.pem> --custom-key <key.pem> [--custom-chain <chain.pem>]
#                                    (serve your own certificate, e.g. bought from a CA: SSL 'custom',
#                                     never replaced by Let's Encrypt; expiry is watched by the panel)
#   whp-site ssl <domain> --wildcard (Let's Encrypt for <domain> and *.<domain> via a DNS-01
#                                     challenge at Cloudflare, see whp-cert-dns: SSL 'wildcard'.
#                                     A subdomain site uses the wildcard of its parent when that covers it)
#   whp-site ssl <domain> --letsencrypt
#                                    (back to the normal automatic Let's Encrypt certificate)
#   whp-site cert <domain>|--all     (which certificate files a site serves, as JSON)
#   whp-site quota <domain> <MB>     (0 = unlimited; hard limit when the filesystem
#                                     has project quotas, see docs/installer.md)
#   whp-site limits <domain> [--cpu 200%] [--memory 1G]   (empty value removes the cap)
#   whp-site owner <domain> <s12|->  (run the site in the slice of subscription 12: whp-sites-s12.slice)
#   whp-site slice <s12> [--cpu 200%] [--memory 2048] [--io 50] [--tasks 512]
#                                    (resource jail of one subscription (website): CPU,
#                                     memory in MB, disk IO in MB/s, processes; empty = no cap)
#   whp-site phpini <domain> [--set memory_limit=256M]... [--reset] [--workers 10]
#                                    (per-site php.ini values as php_admin_value, matching
#                                     Nginx upload size and timeouts, PHP-FPM workers)
#   whp-site suspend <domain> | unsuspend <domain>   (503 page, PHP stopped, SFTP/SSH login locked)
#   whp-site refresh <domain>|--all  (write pool, unit and vhost again from the saved state,
#                                     e.g. after an update of the templates)
#   whp-site proxy <domain> <port>|off
#                                    (serve the whole site from a Node.js or Python app on
#                                     127.0.0.1:<port> instead of PHP; the panel's app manager
#                                     sets this, apps on a sub path use a snippet instead)
#   whp-site https <domain> force|allow
#                                    (force: plain HTTP redirects to HTTPS, the default;
#                                     allow: the site is also served over plain HTTP)
#   whp-site remove <domain> [--keep-files]
#   whp-site list [--json]
#   whp-site show <domain>
#   whp-site alias add <site> <alias> [--redirect] [--no-www] [--no-ssl]
#                                    (extra domain for an existing site: serves the same
#                                     files, or 301-redirects to the site with --redirect;
#                                     own server block and own Let's Encrypt certificate)
#   whp-site alias mode <site> <alias> serve|redirect
#   whp-site alias ssl <site> <alias>
#   whp-site alias remove <site> <alias> [--keep-cert]
#   whp-site alias list <site>
set -Eeuo pipefail
SELF=$(readlink -f "${BASH_SOURCE[0]}")
INSTALLER_DIR=$(cd "$(dirname "$SELF")/.." && pwd)
TPL=$INSTALLER_DIR/templates
# shellcheck source=../lib/common.sh
source "$INSTALLER_DIR/lib/common.sh"
load_lang "$INSTALLER_DIR/lang"
WHP_INSTALL_LOG=$WHP_LOG_DIR/sites.log

SITES_DB=$WHP_STATE/sites
install -d -m 0750 "$SITES_DB"
[[ $EUID -eq 0 ]] || die "$(t need_root)"

WHP_HOSTNAME=$(env_get "$WHP_ETC/installer.env" WHP_HOSTNAME 2>/dev/null || hostname -f)
WHP_LETSENCRYPT_DEFAULT=$(env_get "$WHP_ETC/installer.env" WHP_LETSENCRYPT 2>/dev/null || echo yes)
[[ $WHP_LETSENCRYPT_DEFAULT == no ]] || WHP_LETSENCRYPT_DEFAULT=yes
JSON=no
# --json anywhere: progress goes to stderr, stdout carries only the JSON result.
for a in "$@"; do [[ $a == --json ]] && JSON=yes; done
if [[ $JSON == yes ]]; then exec 3>&1 1>&2; else exec 3>&1; fi

usage() { printf '%b' "$(t usage_site)"; exit 2; }

installed_php() {
  local d v
  for d in /etc/php/*/fpm; do
    v=${d#/etc/php/}; v=${v%/fpm}
    if [[ -x /usr/sbin/php-fpm$v ]]; then echo "$v"; fi
  done | sort -V
}
default_php() { local v; v=$(installed_php | grep -x 8.4 || installed_php | tail -n1); echo "$v"; }

site_file() { printf '%s/%s.env' "$SITES_DB" "$1"; }
site_exists() { [[ -f $(site_file "$1") ]]; }

# Subdomain sites of a site (their SITE_PARENT is the site), one domain per line.
site_children() {
  local f
  for f in "$SITES_DB"/*.env; do
    [[ -e $f ]] || continue
    [[ $(env_get "$f" SITE_PARENT || true) == "$1" ]] && env_get "$f" SITE_DOMAIN
  done
  return 0
}

site_load() {
  local f
  f=$(site_file "$1")
  [[ -f $f ]] || die "$(t site_missing "$1")"
  local k
  for k in SITE_DOMAIN SITE_ID SITE_USER SITE_PHP SITE_ALIASES SITE_CACHE SITE_PROFILE SITE_DOCROOT_REL SITE_SSL SITE_QUOTA_MB SITE_CPU SITE_MEM SITE_CREATED SITE_SUSPENDED SITE_OWNER SITE_PHP_INI SITE_PM_MAX SITE_PARENT SITE_PROXY; do
    printf -v "$k" '%s' "$(env_get "$f" "$k" || true)"
  done
  SITE_ROOT=$WHP_VHOSTS/$SITE_DOMAIN
}

site_save() {
  local f k
  f=$(site_file "$SITE_DOMAIN")
  [[ -f $f ]] || install -m 0640 /dev/null "$f"
  for k in SITE_DOMAIN SITE_ID SITE_USER SITE_PHP SITE_ALIASES SITE_CACHE SITE_PROFILE SITE_DOCROOT_REL SITE_SSL SITE_QUOTA_MB SITE_CPU SITE_MEM SITE_CREATED SITE_SUSPENDED SITE_OWNER SITE_PHP_INI SITE_PM_MAX SITE_PARENT SITE_PROXY; do
    env_set "$f" "$k" "${!k}"
  done
}

make_ids() {
  local d=$1 id
  id=${d//./_}; id=${id//-/_}
  SITE_ID=$id
  if (( ${#id} > 28 )); then
    SITE_USER="s_${id:0:21}_$(printf '%s' "$d" | sha1sum | cut -c1-6)"
  else
    SITE_USER="s_$id"
  fi
}

disable_functions_for() {
  case $1 in
    laravel) echo "passthru,shell_exec,system,pcntl_exec,show_source" ;;
    *) echo "exec,passthru,shell_exec,system,proc_open,popen,pcntl_exec,show_source" ;;
  esac
}

# Slice owner of a site: s<subscription id> (one website on one package), or
# c<customer id> (one slice per customer, before subscriptions). Its PHP runs in that slice.
valid_owner() { [[ $1 =~ ^[cs][0-9]{1,9}$ ]]; }
site_slice() {
  if [[ -n ${SITE_OWNER:-} ]]; then printf 'whp-sites-%s.slice' "$SITE_OWNER"; else printf 'whp-sites.slice'; fi
}
site_cgroup() {
  local p=/sys/fs/cgroup/whp.slice/whp-sites.slice
  [[ -n ${SITE_OWNER:-} ]] && p+="/whp-sites-$SITE_OWNER.slice"
  printf '%s/whp-site-%s.service' "$p" "$SITE_ID"
}

# php.ini keys a site may set. They become php_admin_value, so a script cannot
# raise them again with ini_set(). The panel keeps values below the server maximums.
php_ini_valid() {
  local k=$1 v=$2
  case $k in
    memory_limit|post_max_size|upload_max_filesize) [[ $v =~ ^[1-9][0-9]{0,5}M$ ]] ;;
    max_execution_time|max_input_time) [[ $v =~ ^[0-9]{1,5}$ ]] ;;
    max_input_vars) [[ $v =~ ^[1-9][0-9]{1,6}$ ]] ;;
    display_errors) [[ $v =~ ^(on|off)$ ]] ;;
    *) return 1 ;;
  esac
}

# Value of one key in SITE_PHP_INI ("key=value;key=value"), empty when not set.
php_ini_get() {
  local pairs=() pair
  IFS=';' read -r -a pairs <<<"${SITE_PHP_INI:-}"
  for pair in "${pairs[@]}"; do
    if [[ ${pair%%=*} == "$1" ]]; then printf '%s' "${pair#*=}"; return 0; fi
  done
  return 0
}

# Pool lines, FPM timeout and the matching Nginx limits for the site's PHP settings.
php_ini_render() {
  local pairs=() pair k v
  SITE_PHP_INI_LINES='; Per-site PHP settings (panel: PHP settings)'
  IFS=';' read -r -a pairs <<<"${SITE_PHP_INI:-}"
  for pair in "${pairs[@]}"; do
    k=${pair%%=*}; v=${pair#*=}
    php_ini_valid "$k" "$v" || continue
    if [[ $k == display_errors ]]; then SITE_PHP_INI_LINES+=$'\n'"php_admin_flag[$k] = $v"
    else SITE_PHP_INI_LINES+=$'\n'"php_admin_value[$k] = $v"; fi
  done
  local f=/etc/nginx/whp/sites/$SITE_DOMAIN/10-php-limits.conf
  if [[ -z ${SITE_PHP_INI:-} ]]; then
    SITE_TERMINATE_TIMEOUT=300s
    rm -f "$f"
    return 0
  fi
  local exec input t post up body
  exec=$(php_ini_get max_execution_time); input=$(php_ini_get max_input_time)
  exec=${exec:-120}; input=${input:-120}
  t=$(( exec > input ? exec : input ))
  # 0 means no PHP time limit: FPM still ends a hanging worker after an hour.
  (( t == 0 )) && t=3600
  SITE_TERMINATE_TIMEOUT="$(( t + 30 ))s"
  post=$(php_ini_get post_max_size); up=$(php_ini_get upload_max_filesize)
  post=${post%M}; up=${up%M}; post=${post:-128}; up=${up:-128}
  body=$(( post > up ? post : up ))
  install -d -m 0755 "/etc/nginx/whp/sites/$SITE_DOMAIN"
  printf '# Managed by whp-site: follows the PHP settings of %s.\nclient_max_body_size %sm;\nfastcgi_read_timeout %ss;\n' \
    "$SITE_DOMAIN" "$body" "$(( t + 30 ))" >"$f"
}

# Write the pool and vhost from the saved state and reload services.
site_apply() {
  local old_php=${1:-}
  SITE_ROOT=$WHP_VHOSTS/$SITE_DOMAIN
  SITE_DOCROOT=$SITE_ROOT/${SITE_DOCROOT_REL}
  SITE_NAMES="$SITE_DOMAIN${SITE_ALIASES:+ ${SITE_ALIASES//,/ }}"
  SITE_PM_MAX=${SITE_PM_MAX:-10}
  SITE_OPCACHE_MB=${SITE_OPCACHE_MB:-128}
  SITE_DISABLE_FUNCTIONS=$(disable_functions_for "$SITE_PROFILE")
  SITE_SLICE=$(site_slice)
  php_ini_render
  SITE_SENDER="noreply@$SITE_DOMAIN"
  if [[ $SITE_CACHE == on ]]; then SITE_PHP_INCLUDE=php-cache.conf; else SITE_PHP_INCLUDE=php-nocache.conf; fi

  # Each site has its own PHP-FPM master in its own systemd unit (cgroup):
  # CPU, memory and IO are measured per site and can be capped (whp-site limits),
  # and OPcache is not shared between customers.
  local v unit=whp-site-$SITE_ID
  for v in $(installed_php); do rm -f "/etc/php/$v/fpm/pool.d/site-$SITE_ID.conf"; done
  install -d -m 0755 "$WHP_ETC/php-fpm"
  install -d -m 0750 "$WHP_LOG_DIR/php-fpm"
  {
    render_string "$TPL/php/fpm-site-global.conf"
    render_string "$TPL/php/pool-site.conf"
  } >"$WHP_ETC/php-fpm/$SITE_ID.conf.new"
  "php-fpm$SITE_PHP" -t --fpm-config "$WHP_ETC/php-fpm/$SITE_ID.conf.new" >>"$WHP_INSTALL_LOG" 2>&1 \
    || { rm -f "$WHP_ETC/php-fpm/$SITE_ID.conf.new"; die "php-fpm$SITE_PHP config test failed (see $WHP_INSTALL_LOG)"; }
  mv -f "$WHP_ETC/php-fpm/$SITE_ID.conf.new" "$WHP_ETC/php-fpm/$SITE_ID.conf"
  render "$TPL/systemd/whp-site.service" "/etc/systemd/system/$unit.service"
  site_limits_write
  systemctl daemon-reload
  local body
  if [[ ${SITE_SUSPENDED:-no} == yes ]]; then
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
    install -d -m 0755 /etc/nginx/whp/pages
    [[ -f /etc/nginx/whp/pages/suspended.html ]] \
      || install -m 0644 "$TPL/nginx/pages/suspended.html" /etc/nginx/whp/pages/suspended.html
    body=$(render_string "$TPL/nginx/site-suspended.conf")
  else
    systemctl enable "$unit" >/dev/null 2>&1
    if [[ -n $old_php || ${SITE_RESTART:-no} == yes ]]; then systemctl restart "$unit"
    else systemctl reload-or-restart "$unit"; fi

    # Wait for the socket before nginx sends traffic to it.
    local i
    for i in {1..20}; do [[ -S /run/php/site-$SITE_ID.sock ]] && break; sleep 0.25; done
    if [[ -n ${SITE_PROXY:-} ]]; then body=$(render_string "$TPL/nginx/site-proxy-body.conf")
    else body=$(render_string "$TPL/nginx/site-body.conf"); fi
  fi
  if ssl_serving; then
    site_cert_files
    if nginx_has_http3; then SITE_QUIC="listen 443 quic;
    listen [::]:443 quic;"; else SITE_QUIC="# HTTP/3 not available"; fi
    SITE_BODY=$body
    # shellcheck disable=SC2016 # nginx variables
    SITE_HTTP_BODY='location / { return 301 https://$host$request_uri; }'
    # Force HTTPS can be switched off per site (panel: Redirects & access).
    [[ -f $SITES_DB/$SITE_DOMAIN.http-allowed ]] && SITE_HTTP_BODY=$body
    SITE_HTTPS_SERVER=$(render_string "$TPL/nginx/site-https.conf")
  else
    SITE_HTTP_BODY=$body
    SITE_HTTPS_SERVER="# HTTPS is added as soon as Let's Encrypt has issued a certificate (SSL: $SITE_SSL)"
  fi
  SITE_ALIAS_SERVERS=$(alias_servers "$body")
  nginx_traffic_format
  install -d -m 0755 "/etc/nginx/whp/sites/$SITE_DOMAIN"
  render "$TPL/nginx/site.conf" "/etc/nginx/sites-available/whp-$SITE_DOMAIN.conf"
  ln -sf "../sites-available/whp-$SITE_DOMAIN.conf" "/etc/nginx/sites-enabled/whp-$SITE_DOMAIN.conf"
  if ! nginx -t >>"$WHP_INSTALL_LOG" 2>&1; then
    rm -f "/etc/nginx/sites-enabled/whp-$SITE_DOMAIN.conf"
    die "nginx config test failed for $SITE_DOMAIN (see $WHP_INSTALL_LOG)"
  fi
  nginx_reload_wait
}

# Reload nginx and wait until the old workers (old config) are gone,
# so the next request is answered with the new configuration.
nginx_reload_wait() {
  local master old cur i
  master=$(cat /run/nginx.pid 2>/dev/null || true)
  old=''
  if [[ -n $master ]]; then old=$(pgrep -P "$master" | sort || true); fi
  systemctl reload nginx
  [[ -n $old ]] || return 0
  for i in {1..100}; do
    cur=$(pgrep -P "$master" | sort || true)
    [[ -z $(comm -12 <(printf '%s\n' "$old") <(printf '%s\n' "$cur")) ]] && break
    sleep 0.1
  done
  return 0
}

# ---- Domain aliases -------------------------------------------------------
# One line per alias in <site>.aliases: "<alias> <serve|redirect> <www yes|no> <ssl>"
# (ssl: off, pending or active). Every alias gets its own server block and its
# own certificate (cert name = the alias), so an alias whose DNS does not point
# here yet never blocks the certificate of the main site.

alias_file() { printf '%s/%s.aliases' "$SITES_DB" "$1"; }

alias_lines() {
  local f
  f=$(alias_file "$1")
  [[ -f $f ]] || return 0
  grep -E '^[a-z0-9.-]+ (serve|redirect) (yes|no) (off|pending|active)$' "$f" || true
}

# alias_get <site> <alias>: sets ALIAS_MODE ALIAS_WWW ALIAS_SSL, status 1 when unknown.
alias_get() {
  local line
  line=$(alias_lines "$1" | awk -v a="$2" '$1 == a' | tail -n1)
  [[ -n $line ]] || return 1
  read -r _ ALIAS_MODE ALIAS_WWW ALIAS_SSL <<<"$line"
}

alias_put() {
  local site=$1 a=$2 f tmp
  f=$(alias_file "$site")
  tmp=$(mktemp)
  { alias_lines "$site" | awk -v a="$a" '$1 != a'; printf '%s %s %s %s\n' "$a" "$ALIAS_MODE" "$ALIAS_WWW" "$ALIAS_SSL"; } | sort >"$tmp"
  install -m 0640 "$tmp" "$f"
  rm -f "$tmp"
}

alias_del() {
  local site=$1 a=$2 f tmp
  f=$(alias_file "$site")
  [[ -f $f ]] || return 0
  tmp=$(mktemp)
  alias_lines "$site" | awk -v a="$a" '$1 != a' >"$tmp"
  if [[ -s $tmp ]]; then install -m 0640 "$tmp" "$f"; else rm -f "$f"; fi
  rm -f "$tmp"
}

# Host names of the site's domain aliases (comma separated), for cache purges.
alias_names() {
  local a mode www ssl out=''
  while read -r a mode www ssl; do
    [[ -n $a ]] || continue
    out+="${out:+,}$a"
    [[ $www == yes ]] && out+=",www.$a"
  done < <(alias_lines "$1")
  printf '%s' "$out"
}

# Is this host name served by any site on the server (domain, www alias or domain alias)?
# Prints the owning site.
name_owner() {
  local name=$1 f d al
  for f in "$SITES_DB"/*.env; do
    [[ -e $f ]] || continue
    d=$(env_get "$f" SITE_DOMAIN)
    al=$(env_get "$f" SITE_ALIASES || true)
    if [[ $name == "$d" || ",$al," == *",$name,"* || ",$(alias_names "$d")," == *",$name,"* ]]; then
      printf '%s' "$d"; return 0
    fi
  done
  return 1
}

# Server blocks for every alias of the loaded site. $1 = the site's location body.
alias_servers() {
  local body=$1 a mode www ssl out='' target_scheme=http
  ssl_serving && target_scheme=https
  while read -r a mode www ssl; do
    [[ -n $a ]] || continue
    out+=$(
      ALIAS_DOMAIN=$a ALIAS_MODE=$mode ALIAS_SSL=$ssl
      ALIAS_NAMES=$a
      [[ $www == yes ]] && ALIAS_NAMES+=" www.$a"
      if [[ $mode == redirect ]]; then
        # shellcheck disable=SC2016 # nginx variables
        inner="location / { return 301 $target_scheme://$SITE_DOMAIN\$request_uri; }"
      else
        inner=$body
      fi
      if [[ $ssl == active && -r /etc/letsencrypt/live/$a/fullchain.pem ]]; then
        # shellcheck disable=SC2016 # nginx variables
        ALIAS_HTTP_BODY='location / { return 301 https://$host$request_uri; }'
        if nginx_has_http3; then SITE_QUIC="listen 443 quic;
    listen [::]:443 quic;"; else SITE_QUIC="# HTTP/3 not available"; fi
        SITE_NAMES=$ALIAS_NAMES
        SITE_CERT=/etc/letsencrypt/live/$a/fullchain.pem
        SITE_KEY=/etc/letsencrypt/live/$a/privkey.pem
        SITE_BODY=$inner
        ALIAS_HTTPS_SERVER=$(render_string "$TPL/nginx/site-https.conf")
      else
        if [[ $mode == redirect ]]; then ALIAS_HTTP_BODY=$inner; else ALIAS_HTTP_BODY=$body; fi
        ALIAS_HTTPS_SERVER="# HTTPS for $a is added as soon as Let's Encrypt has issued a certificate (SSL: $ssl)"
      fi
      render_string "$TPL/nginx/site-alias.conf"
    )
    out+=$'\n'
  done < <(alias_lines "$SITE_DOMAIN")
  [[ -n $out ]] || out="# No domain aliases"
  printf '%s' "$out"
}

# Request the certificate of one alias; sets ALIAS_SSL.
alias_cert() {
  local a=$1 names=()
  [[ $ALIAS_WWW == yes ]] && names=("www.$a")
  if "$INSTALLER_DIR/bin/whp-cert" "$a" "${names[@]}" \
     || { ((${#names[@]})) && "$INSTALLER_DIR/bin/whp-cert" "$a"; }; then
    ALIAS_SSL=active
    info "$(t cert_ok "$a")"
  else
    ALIAS_SSL=pending
    warn "No Let's Encrypt certificate for alias $a yet (DNS not pointing here?). Served over HTTP until it is issued; retried every hour."
  fi
}

print_aliases() {
  local site=$1 a mode www ssl out='[]'
  while read -r a mode www ssl; do
    [[ -n $a ]] || continue
    out=$(jq -c --arg a "$a" --arg m "$mode" --arg w "$www" --arg s "$ssl" \
      '. + [{domain:$a, mode:$m, www:($w=="yes"), ssl:$s, names:([$a] + (if $w=="yes" then ["www."+$a] else [] end))}]' <<<"$out")
  done < <(alias_lines "$site")
  printf '%s' "$out"
}

cmd_alias() {
  local sub=${1:-} site=${2:-} a=${3:-}
  [[ -n $sub && -n $site ]] || usage
  shift 2 || true
  [[ $sub == list ]] || { [[ -n $a ]] || usage; shift; }
  site=${site,,}; a=${a,,}; a=${a%.}
  site_load "$site"
  case $sub in
    list)
      jq -n >&3 --arg d "$site" --argjson al "$(print_aliases "$site")" '{domain:$d, domain_aliases:$al}'
      return 0 ;;
    add)
      valid_domain "$a" || die "$(t bad_hostname "$a")"
      [[ $a == "$site" || $a == "www.$site" ]] && die "$a is the site itself"
      local owner want_ssl=$WHP_LETSENCRYPT_DEFAULT
      ALIAS_MODE=serve ALIAS_WWW=yes
      [[ $a == www.* ]] && ALIAS_WWW=no
      while (($#)); do
        case $1 in
          --redirect) ALIAS_MODE=redirect ;;
          --no-www) ALIAS_WWW=no ;;
          --no-ssl) want_ssl=no ;;
          --json) ;;
          *) usage ;;
        esac
        shift
      done
      if alias_get "$site" "$a"; then die "$a is already an alias of $site"; fi
      if owner=$(name_owner "$a"); then die "$a is already in use by site $owner"; fi
      if [[ $ALIAS_WWW == yes ]] && owner=$(name_owner "www.$a"); then die "www.$a is already in use by site $owner"; fi
      if [[ $want_ssl == yes ]]; then ALIAS_SSL=pending; else ALIAS_SSL=off; fi
      alias_put "$site" "$a"
      site_apply
      if [[ $want_ssl == yes ]]; then
        alias_cert "$a"
        alias_put "$site" "$a"
        [[ $ALIAS_SSL == active ]] && site_apply
      fi
      ok "alias $a added to $site ($ALIAS_MODE, SSL $ALIAS_SSL)" ;;
    mode)
      local m=${1:-}
      [[ $m == serve || $m == redirect ]] || usage
      alias_get "$site" "$a" || die "$a is not an alias of $site"
      ALIAS_MODE=$m
      alias_put "$site" "$a"
      site_apply
      cache_purge
      ok "alias $a of $site: $m" ;;
    ssl)
      alias_get "$site" "$a" || die "$a is not an alias of $site"
      alias_cert "$a"
      alias_put "$site" "$a"
      site_apply ;;
    remove)
      local keep_cert=no
      [[ ${1:-} == --keep-cert ]] && keep_cert=yes
      alias_get "$site" "$a" || die "$a is not an alias of $site"
      cache_purge
      alias_del "$site" "$a"
      site_apply
      if [[ $keep_cert == no ]]; then
        certbot delete --non-interactive --cert-name "$a" >>"$WHP_INSTALL_LOG" 2>&1 || true
      fi
      ok "alias $a removed from $site" ;;
    *) usage ;;
  esac
  if [[ $JSON == yes ]]; then
    jq -n >&3 --arg d "$site" --argjson al "$(print_aliases "$site")" --arg a "$a" \
      '{domain:$d, alias:(($al | map(select(.domain==$a)))[0] // {domain:$a, removed:true}), domain_aliases:$al}'
  fi
}

# Remove this site's pages from the Nginx page cache (all its host names).
cache_purge() {
  local names re al
  al=$(alias_names "$SITE_DOMAIN")
  names="$SITE_DOMAIN${SITE_ALIASES:+,$SITE_ALIASES}${al:+,$al}"
  re="^KEY: https?(GET|HEAD)($(sed 's/\./\\./g; s/,/|/g' <<<"$names"))/"
  [[ -d /var/cache/nginx/whp ]] || return 0
  # No match is fine: never let grep's exit status trip pipefail or the ERR trap.
  { grep -rlZaE "$re" /var/cache/nginx/whp 2>/dev/null || true; } | { xargs -0 -r rm -f || true; }
  return 0
}

# Render a template to stdout (same rules as render()).
render_string() {
  local tmp
  tmp=$(mktemp)
  render "$1" "$tmp"
  cat "$tmp"
  rm -f "$tmp"
}

imported_cert_dir() { printf '%s/ssl/%s' "$WHP_ETC" "$1"; }

# ---- Certificate sources --------------------------------------------------
# SITE_SSL: off, pending (waiting for Let's Encrypt), active (Let's Encrypt,
# HTTP-01), imported (taken over from another server until Let's Encrypt
# works), custom (uploaded own certificate, kept until replaced) or wildcard
# (Let's Encrypt <base> + *.<base> through Cloudflare DNS-01).

ssl_serving() { [[ $SITE_SSL =~ ^(active|imported|custom|wildcard)$ ]]; }

# SSL state for the panel's website list: an own or wildcard certificate is a
# valid certificate ("active"); "whp-site cert" tells which source it is.
ssl_public() { if [[ $SITE_SSL == custom || $SITE_SSL == wildcard ]]; then printf active; else printf '%s' "$SITE_SSL"; fi; }

# Does the wildcard certificate of <base> cover host name <name>?
wildcard_covers() {
  local base=$1 name=$2 label
  [[ $name == "$base" ]] && return 0
  [[ $name == *".$base" ]] || return 1
  label=${name%".$base"}
  [[ $label != *.* ]]
}

# The domain whose wildcard certificate the loaded site serves: its own, or
# the one of its parent site when that covers the site and all its names.
wildcard_base() {
  local live=/etc/letsencrypt/live/whp-wildcard- n names=()
  if [[ -r $live$SITE_DOMAIN/fullchain.pem || -z ${SITE_PARENT:-} || ! -r $live$SITE_PARENT/fullchain.pem ]]; then
    printf '%s' "$SITE_DOMAIN"; return 0
  fi
  [[ -n $SITE_ALIASES ]] && IFS=',' read -r -a names <<<"$SITE_ALIASES"
  for n in "$SITE_DOMAIN" "${names[@]}"; do
    wildcard_covers "$SITE_PARENT" "$n" || { printf '%s' "$SITE_DOMAIN"; return 0; }
  done
  printf '%s' "$SITE_PARENT"
}

# Sets SITE_CERT and SITE_KEY for the loaded site's certificate source.
site_cert_files() {
  local dir
  case $SITE_SSL in
    imported|custom) dir=$(imported_cert_dir "$SITE_DOMAIN") ;;
    wildcard) dir=/etc/letsencrypt/live/whp-wildcard-$(wildcard_base) ;;
    *) dir=/etc/letsencrypt/live/$SITE_DOMAIN ;;
  esac
  SITE_CERT=$dir/fullchain.pem
  SITE_KEY=$dir/privkey.pem
}

# Install an own certificate (cert + key + optional intermediate chain).
site_cert_custom() {
  local cert=$1 key=$2 chain=${3:-} dir tmp
  [[ -r $cert && -r $key ]] || die "certificate or key file not readable"
  [[ -z $chain || -r $chain ]] || die "chain file not readable"
  openssl x509 -noout -in "$cert" >/dev/null 2>&1 || die "not a PEM certificate: $cert"
  [[ "$(openssl x509 -pubkey -noout -in "$cert")" == "$(openssl pkey -pubout -in "$key" 2>/dev/null)" ]] \
    || die "the key does not belong to the certificate"
  openssl x509 -checkend 0 -noout -in "$cert" >/dev/null || die "the certificate has expired"
  dir=$(imported_cert_dir "$SITE_DOMAIN")
  install -d -m 0700 "$dir"
  tmp=$(mktemp "$dir/.new.XXXX")
  { openssl x509 -in "$cert"; [[ -z $chain ]] || cat "$chain"; } >"$tmp"
  chmod 0644 "$tmp"
  install -m 0600 "$key" "$dir/privkey.pem.new"
  mv -f "$tmp" "$dir/fullchain.pem"
  mv -f "$dir/privkey.pem.new" "$dir/privkey.pem"
  SITE_SSL=custom
  info "own certificate installed for $SITE_DOMAIN (valid until $(openssl x509 -noout -enddate -in "$cert" | cut -d= -f2))"
}

# Issue (or renew) the wildcard certificate; dies with certbot's reason.
site_cert_wildcard() {
  local base err
  base=$(wildcard_base)
  if [[ $base != "$SITE_DOMAIN" ]]; then
    info "$SITE_DOMAIN uses the wildcard certificate of $base"
  elif ! err=$("$INSTALLER_DIR/bin/whp-cert-dns" "$SITE_DOMAIN" 2>&1 >/dev/null); then
    die "No wildcard certificate for $SITE_DOMAIN: ${err:-certbot failed (see /var/log/webhosting-panel/certbot.log)}"
  fi
  SITE_SSL=wildcard
  info "$(t cert_ok "*.$base")"
}

# The site no longer serves its own wildcard certificate: delete it, unless
# a subdomain site still uses it.
wildcard_cleanup() {
  local domain=$1 f
  [[ -e /etc/letsencrypt/renewal/whp-wildcard-$domain.conf ]] || return 0
  for f in "$SITES_DB"/*.env; do
    [[ -e $f ]] || continue
    [[ $(env_get "$f" SITE_PARENT || true) == "$domain" && $(env_get "$f" SITE_SSL || true) == wildcard ]] && return 0
  done
  certbot delete --non-interactive --cert-name "whp-wildcard-$domain" >>"$WHP_INSTALL_LOG" 2>&1 || true
}

# Which certificate a site serves, as JSON (the agent reads the files for details).
print_cert() {
  site_load "$1"
  local cert='' key=''
  if ssl_serving; then site_cert_files; cert=$SITE_CERT; key=$SITE_KEY; fi
  [[ -n $cert && ! -r $cert ]] && cert='' key=''
  local base=''
  [[ $SITE_SSL == wildcard ]] && base=$(wildcard_base)
  jq -n --arg d "$SITE_DOMAIN" --arg ssl "$SITE_SSL" --arg cert "$cert" --arg key "$key" --arg base "$base" \
    --arg aliases "$SITE_ALIASES" --arg parent "${SITE_PARENT:-}" \
    '{domain:$d, ssl:$ssl, cert_file:(if $cert == "" then null else $cert end), key_file:(if $key == "" then null else $key end),
      wildcard_of:(if $base == "" then null else $base end), parent:(if $parent == "" then null else $parent end),
      names:([$d] + ($aliases|split(",")|map(select(length>0))))}'
}

cmd_cert() {
  local target=${1:-} f out='[]'
  [[ -n $target ]] || usage
  if [[ $target == --all ]]; then
    for f in "$SITES_DB"/*.env; do
      [[ -e $f ]] || continue
      out=$(jq -c --argjson c "$(print_cert "$(env_get "$f" SITE_DOMAIN)")" '. + [$c]' <<<"$out")
    done
    jq -n --argjson c "$out" '{certificates:$c}' >&3
  else
    print_cert "${target,,}" >&3
  fi
}

site_cert() {
  local names=()
  [[ -n $SITE_ALIASES ]] && IFS=',' read -r -a names <<<"$SITE_ALIASES"
  if "$INSTALLER_DIR/bin/whp-cert" "$SITE_DOMAIN" "${names[@]}" \
     || { ((${#names[@]})) && "$INSTALLER_DIR/bin/whp-cert" "$SITE_DOMAIN"; }; then
    SITE_SSL=active
    info "$(t cert_ok "$SITE_DOMAIN")"
  elif [[ $SITE_SSL == imported && -s $(imported_cert_dir "$SITE_DOMAIN")/fullchain.pem ]]; then
    # Keep serving the certificate from the old server until DNS points here.
    warn "$(t site_cert_pending "$SITE_DOMAIN" "$SITE_DOMAIN")"
  else
    SITE_SSL=pending
    warn "$(t site_cert_pending "$SITE_DOMAIN" "$SITE_DOMAIN")"
  fi
}

# Install a certificate taken over from another server (migration).
site_cert_import() {
  local cert=$1 key=$2 dir
  [[ -r $cert && -r $key ]] || die "certificate or key file not readable"
  openssl x509 -noout -in "$cert" >/dev/null 2>&1 || die "not a PEM certificate: $cert"
  [[ "$(openssl x509 -pubkey -noout -in "$cert")" == "$(openssl pkey -pubout -in "$key" 2>/dev/null)" ]] \
    || die "the key does not belong to the certificate"
  dir=$(imported_cert_dir "$SITE_DOMAIN")
  install -d -m 0700 "$dir"
  install -m 0644 "$cert" "$dir/fullchain.pem"
  install -m 0600 "$key" "$dir/privkey.pem"
  SITE_SSL=imported
  info "imported certificate for $SITE_DOMAIN (valid until $(openssl x509 -noout -enddate -in "$cert" | cut -d= -f2))"
}

print_site() {
  site_load "$1"
  jq -n >&3 --arg domain "$SITE_DOMAIN" --arg user "$SITE_USER" --arg php "$SITE_PHP" \
    --arg aliases "$SITE_ALIASES" --arg cache "$SITE_CACHE" --arg profile "$SITE_PROFILE" \
    --arg root "$SITE_ROOT" --arg docroot "$SITE_ROOT/$SITE_DOCROOT_REL" --arg ssl "$(ssl_public)" \
    --arg created "$SITE_CREATED" --arg socket "/run/php/site-$SITE_ID.sock" \
    --arg unit "whp-site-$SITE_ID.service" \
    --argjson quota "${SITE_QUOTA_MB:-0}" --arg qmode "$(quota_mode)" \
    --argjson res "$(site_resources)" \
    --arg cpu_limit "$SITE_CPU" --arg mem_limit "$SITE_MEM" \
    --arg suspended "${SITE_SUSPENDED:-no}" \
    --argjson domain_aliases "$(print_aliases "$1")" \
    --arg owner "${SITE_OWNER:-}" --arg slice "$(site_slice)" --arg cgroup "$(site_cgroup)" \
    --arg php_ini "${SITE_PHP_INI:-}" --argjson workers "${SITE_PM_MAX:-10}" \
    --arg parent "${SITE_PARENT:-}" --arg proxy "${SITE_PROXY:-}" --arg children "$(site_children "$1" | xargs)" \
    --argjson used "$(du -sm --one-file-system "$SITE_ROOT" 2>/dev/null | cut -f1 || echo 0)" \
    '{domain:$domain, user:$user, php:$php, aliases:($aliases|split(",")|map(select(length>0))), domain_aliases:$domain_aliases,
      cache:($cache=="on"), suspended:($suspended=="yes"), profile:$profile, root:$root, docroot:$docroot, ssl:$ssl,
      socket:$socket, created:$created, unit:$unit,
      owner:(if $owner == "" then null else $owner end), slice:$slice, cgroup:$cgroup,
      php_ini:([$php_ini|split(";")[]|select(contains("="))|{key:(split("=")[0]), value:(split("=")[1:]|join("="))}]|from_entries),
      php_workers:$workers,
      parent:(if $parent == "" then null else $parent end), proxy_port:(if $proxy == "" then null else ($proxy|tonumber) end), subdomains:($children|split(" ")|map(select(length>0))),
      disk:{used_mb:$used, quota_mb:$quota, enforced:($qmode!="none" and $quota>0), mode:$qmode},
      resources:($res + {cpu_limit:$cpu_limit, memory_limit:$mem_limit})}'
}

# Undo a site whose first setup failed: state, vhost, PHP unit. Files and the
# user stay (an add with the same domain reuses them).
add_rollback() {
  local rc=$?
  [[ $rc -ne 0 && -n ${ADD_DOMAIN:-} ]] || return 0
  rm -f "$(site_file "$ADD_DOMAIN")" "/etc/nginx/sites-enabled/whp-$ADD_DOMAIN.conf" "/etc/nginx/sites-available/whp-$ADD_DOMAIN.conf"
  systemctl disable --now "whp-site-$SITE_ID" >/dev/null 2>&1 || true
  rm -rf "/etc/systemd/system/whp-site-$SITE_ID.service" "/etc/systemd/system/whp-site-$SITE_ID.service.d"
  systemctl daemon-reload >/dev/null 2>&1 || true
  printf '%s rolled back: the site was not created, you can try again.\n' "$ADD_DOMAIN" >>"$WHP_INSTALL_LOG"
}

cmd_add() {
  local domain=${1:-}; shift || true
  [[ -n $domain ]] || usage
  domain=${domain,,}
  valid_domain "$domain" || die "$(t bad_hostname "$domain")"
  site_exists "$domain" && die "$(t site_exists "$domain")"
  local owner
  if owner=$(name_owner "$domain"); then die "$domain is already served by site $owner (remove the alias first)"; fi

  SITE_DOMAIN=$domain SITE_PHP=$(default_php) SITE_ALIASES='' SITE_CACHE=on SITE_PROFILE=php
  SITE_DOCROOT_REL='' SITE_SSL=$WHP_LETSENCRYPT_DEFAULT SITE_QUOTA_MB=0 SITE_CPU='' SITE_MEM='' SITE_SUSPENDED=no
  SITE_OWNER='' SITE_PHP_INI='' SITE_PM_MAX=10 SITE_PARENT='' SITE_PROXY=''
  local alias_set=no
  while (($#)); do
    case $1 in
      --php) SITE_PHP=$2; shift ;;
      --alias) SITE_ALIASES+="${SITE_ALIASES:+,}${2,,}"; alias_set=yes; shift ;;
      --no-alias) alias_set=yes ;;
      --profile) SITE_PROFILE=$2; shift ;;
      --docroot) SITE_DOCROOT_REL=$2; shift ;;
      --no-cache) SITE_CACHE=off ;;
      --no-ssl) SITE_SSL=off ;;
      --quota) SITE_QUOTA_MB=$2; shift ;;
      --owner) valid_owner "$2" || die "--owner: s<subscription id>, e.g. s12"; SITE_OWNER=$2; shift ;;
      --workers) [[ $2 =~ ^[1-9][0-9]{0,2}$ ]] || die "--workers: 1-999"; SITE_PM_MAX=$2; shift ;;
      --parent) SITE_PARENT=${2,,}; shift ;;
      --json) JSON=yes ;;
      *) usage ;;
    esac
    shift
  done
  [[ -x /usr/sbin/php-fpm$SITE_PHP ]] || die "$(t bad_php "$SITE_PHP" "$(installed_php | xargs)")"
  case $SITE_PROFILE in php|wordpress|laravel) ;; *) die "profile: php|wordpress|laravel" ;; esac
  if [[ -n $SITE_PARENT ]]; then
    # One level below the parent (test.example.com), and the parent is a main site.
    site_exists "$SITE_PARENT" || die "$(t site_missing "$SITE_PARENT")"
    [[ $domain == *."$SITE_PARENT" && ${domain%."$SITE_PARENT"} =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] \
      || die "$domain is not a subdomain of $SITE_PARENT"
    [[ -z $(env_get "$(site_file "$SITE_PARENT")" SITE_PARENT || true) ]] || die "$SITE_PARENT is itself a subdomain"
    # The disk quota is the parent's: the subdomain's files count towards it.
    SITE_QUOTA_MB=0
    [[ $alias_set == no ]] && alias_set=yes
  fi
  [[ $alias_set == no && $domain != www.* ]] && SITE_ALIASES="www.$domain"
  if [[ -z $SITE_DOCROOT_REL ]]; then
    # Laravel: the repository goes in app/, Nginx serves app/public.
    if [[ $SITE_PROFILE == laravel ]]; then SITE_DOCROOT_REL=app/public; else SITE_DOCROOT_REL=public; fi
  fi
  [[ $SITE_DOCROOT_REL =~ ^[A-Za-z0-9._/-]+$ && $SITE_DOCROOT_REL != *..* ]] || die "invalid docroot"
  [[ $SITE_PROFILE == laravel && $SITE_CACHE == on ]] && SITE_CACHE=off
  local a
  for a in ${SITE_ALIASES//,/ }; do valid_domain "$a" || die "$(t bad_hostname "$a")"; done

  make_ids "$domain"
  SITE_CREATED=$(date -u +%FT%TZ)
  SITE_ROOT=$WHP_VHOSTS/$domain

  getent passwd "$SITE_USER" >/dev/null || useradd --system --user-group --home-dir "$SITE_ROOT" \
    --no-create-home --shell /usr/sbin/nologin "$SITE_USER"
  install -d -m 0750 -o "$SITE_USER" -g www-data "$SITE_ROOT"
  install -d -m 0750 -o "$SITE_USER" -g www-data "$SITE_ROOT/logs"
  install -d -m 0700 -o "$SITE_USER" -g "$SITE_USER" "$SITE_ROOT/tmp" "$SITE_ROOT/sessions"
  install -d -m 0755 -o "$SITE_USER" -g "$SITE_USER" "$SITE_ROOT/$SITE_DOCROOT_REL"
  # Directories between the site root and the docroot (Laravel: app/).
  local p=$SITE_ROOT/$SITE_DOCROOT_REL
  while p=$(dirname "$p"); [[ $p != "$SITE_ROOT" && $p == "$SITE_ROOT"/* ]]; do
    chown "$SITE_USER:$SITE_USER" "$p"; chmod 0755 "$p"
  done
  if [[ ! -e $SITE_ROOT/$SITE_DOCROOT_REL/index.php && ! -e $SITE_ROOT/$SITE_DOCROOT_REL/index.html ]]; then
    printf '<!doctype html><meta charset="utf-8"><title>%s</title><p>%s</p>\n' "$domain" "$domain" \
      >"$SITE_ROOT/$SITE_DOCROOT_REL/index.html"
    chown "$SITE_USER:$SITE_USER" "$SITE_ROOT/$SITE_DOCROOT_REL/index.html"
  fi

  # A failed first setup must not leave a half site behind ("already exists" on retry).
  ADD_DOMAIN=$domain
  trap add_rollback EXIT

  # First serve HTTP (needed for the ACME challenge), then add HTTPS.
  local want_ssl=$SITE_SSL
  [[ $want_ssl == yes ]] && SITE_SSL=pending
  site_save
  site_apply
  if [[ $want_ssl == yes ]]; then
    site_cert
    site_save
    [[ $SITE_SSL == active ]] && site_apply
  fi
  if [[ -n $SITE_PARENT ]]; then quota_apply; elif (( SITE_QUOTA_MB > 0 )); then quota_apply; fi
  [[ -n $SITE_OWNER ]] && user_slice_write
  trap - EXIT
  if [[ $JSON == yes ]]; then print_site "$domain"; else ok "$(t site_added "$domain" "$SITE_PHP")"; fi
}

# CPU and memory caps for the site's unit (empty = no cap).
site_limits_write() {
  local d=/etc/systemd/system/whp-site-$SITE_ID.service.d
  install -d -m 0755 "$d"
  {
    echo "# Managed by whp-site"
    echo "[Service]"
    [[ -n $SITE_CPU ]] && echo "CPUQuota=$SITE_CPU"
    [[ -n $SITE_MEM ]] && printf 'MemoryHigh=%s\nMemoryMax=%s\n' "$SITE_MEM" "$SITE_MEM"
    echo "TasksMax=512"
  } >"$d/limits.conf"
}

# Live usage from the site's cgroup.
site_resources() {
  local out
  out=$(systemctl show "whp-site-$SITE_ID" -p ActiveState -p CPUUsageNSec -p MemoryCurrent -p IOReadBytes -p IOWriteBytes -p TasksCurrent 2>/dev/null)
  jq -Rn --arg raw "$out" '[$raw|split("\n")[]|select(length>0)|split("=")|{(.[0]):(.[1:]|join("="))}]|add // {}
    | {state:(.ActiveState//"unknown"),
       cpu_seconds:((.CPUUsageNSec|tonumber? // 0)/1e9),
       memory_bytes:(.MemoryCurrent|tonumber? // 0),
       io_read_bytes:(.IOReadBytes|tonumber? // 0),
       io_write_bytes:(.IOWriteBytes|tonumber? // 0),
       tasks:(.TasksCurrent|tonumber? // 0)}'
}

cmd_limits() {
  local domain=${1:-}; shift || true
  [[ -n $domain ]] || usage
  site_load "$domain"
  while (($#)); do
    case $1 in
      --cpu) [[ $2 =~ ^([0-9]+%)?$ ]] || die "--cpu: e.g. 200% (2 cores) or empty"; SITE_CPU=$2; shift ;;
      --memory) [[ $2 =~ ^([0-9]+[KMG])?$ ]] || die "--memory: e.g. 1G or empty"; SITE_MEM=$2; shift ;;
      --json) ;;
      *) usage ;;
    esac
    shift
  done
  site_save
  site_limits_write
  systemctl daemon-reload
  systemctl try-restart "whp-site-$SITE_ID"
  ok "$domain cpu ${SITE_CPU:-unlimited} memory ${SITE_MEM:-unlimited}"
  if [[ $JSON == yes ]]; then print_site "$domain"; fi
}

# ---- Subscription resource jail --------------------------------------------
# Every subscription (one website on one package) runs in whp-sites-<owner>.slice.
# Without caps the slices share the server fairly (equal CPU and IO weight); with
# caps a website can never use more than its package allows, whatever it does.
SLICES_DB=$WHP_STATE/slices

slice_load() {
  local f=$SLICES_DB/$1.env k
  for k in SLICE_CPU SLICE_MEM SLICE_IO SLICE_TASKS; do
    printf -v "$k" '%s' "$(env_get "$f" "$k" 2>/dev/null || true)"
  done
}

# [Slice]/[Service] resource lines for the current SLICE_* values.
slice_properties() {
  echo "CPUWeight=100"
  echo "IOWeight=100"
  [[ -n $SLICE_CPU ]] && echo "CPUQuota=$SLICE_CPU"
  if [[ -n $SLICE_MEM ]]; then
    # Reclaim and slow down at 90 %, hard stop at 100 %.
    echo "MemoryHigh=$(( SLICE_MEM * 9 / 10 ))M"
    echo "MemoryMax=${SLICE_MEM}M"
  fi
  if [[ -n $SLICE_IO ]]; then
    echo "IOReadBandwidthMax=$WHP_VHOSTS ${SLICE_IO}M"
    echo "IOWriteBandwidthMax=$WHP_VHOSTS ${SLICE_IO}M"
  fi
  [[ -n $SLICE_TASKS ]] && echo "TasksMax=$SLICE_TASKS"
  return 0
}

# SSH/SFTP sessions of a site user run in user-<uid>.slice (logind): give it the same caps.
user_slice_write() {
  local uid d
  uid=$(id -u "$SITE_USER" 2>/dev/null) || return 0
  d=/etc/systemd/system/user-$uid.slice.d
  if [[ -z ${SITE_OWNER:-} ]]; then rm -rf "$d"; return 0; fi
  slice_load "$SITE_OWNER"
  install -d -m 0755 "$d"
  { echo "# Managed by whp-site: same limits as $SITE_OWNER ($SITE_DOMAIN)"; echo "[Slice]"; slice_properties; } >"$d/50-whp.conf"
}

cmd_slice() {
  local owner=${1:-}; shift || true
  valid_owner "$owner" || usage
  slice_load "$owner"
  while (($#)); do
    case $1 in
      --cpu) [[ $2 =~ ^([1-9][0-9]{0,4}%)?$ ]] || die "--cpu: e.g. 200% (2 cores) or empty"; SLICE_CPU=$2; shift ;;
      --memory) [[ $2 =~ ^([1-9][0-9]{1,7})?$ ]] || die "--memory: MB, e.g. 2048, or empty"; SLICE_MEM=$2; shift ;;
      --io) [[ $2 =~ ^([1-9][0-9]{0,5})?$ ]] || die "--io: MB/s, e.g. 50, or empty"; SLICE_IO=$2; shift ;;
      --tasks) [[ $2 =~ ^([1-9][0-9]{1,5})?$ ]] || die "--tasks: e.g. 512, or empty"; SLICE_TASKS=$2; shift ;;
      --json) ;;
      *) usage ;;
    esac
    shift
  done
  install -d -m 0750 "$SLICES_DB"
  local f=$SLICES_DB/$owner.env k
  for k in SLICE_CPU SLICE_MEM SLICE_IO SLICE_TASKS; do env_set "$f" "$k" "${!k}"; done
  {
    echo "# Managed by whp-site: resource limits for $owner (subscription s<id>, or customer c<id>)."
    echo "[Unit]"
    echo "Description=Webhosting Panel $owner"
    echo
    echo "[Slice]"
    slice_properties
  } >"/etc/systemd/system/whp-sites-$owner.slice"
  # Same caps for the SSH/SFTP sessions of the site users in this slice.
  local sf
  for sf in "$SITES_DB"/*.env; do
    [[ -e $sf ]] || continue
    [[ $(env_get "$sf" SITE_OWNER || true) == "$owner" ]] || continue
    ( site_load "$(env_get "$sf" SITE_DOMAIN)"; user_slice_write )
  done
  systemctl daemon-reload
  # Apply to the running slice right away (an empty value removes the cap).
  local props=(CPUQuota="$SLICE_CPU" TasksMax="${SLICE_TASKS:-infinity}")
  if [[ -n $SLICE_MEM ]]; then props+=(MemoryHigh="$(( SLICE_MEM * 9 / 10 ))M" MemoryMax="${SLICE_MEM}M")
  else props+=(MemoryHigh=infinity MemoryMax=infinity); fi
  if [[ -n $SLICE_IO ]]; then props+=("IOReadBandwidthMax=$WHP_VHOSTS ${SLICE_IO}M" "IOWriteBandwidthMax=$WHP_VHOSTS ${SLICE_IO}M")
  else props+=(IOReadBandwidthMax= IOWriteBandwidthMax=); fi
  if systemctl is-active --quiet "whp-sites-$owner.slice"; then
    systemctl set-property --runtime "whp-sites-$owner.slice" "${props[@]}" >>"$WHP_INSTALL_LOG" 2>&1 \
      || warn "could not apply the limits of $owner to the running slice; they apply after the next restart"
  fi
  ok "$owner cpu ${SLICE_CPU:-unlimited}, memory ${SLICE_MEM:-unlimited} MB, io ${SLICE_IO:-unlimited} MB/s, tasks ${SLICE_TASKS:-unlimited}"
  if [[ $JSON == yes ]]; then
    jq -n >&3 --arg owner "$owner" --arg cpu "$SLICE_CPU" --arg mem "$SLICE_MEM" --arg io "$SLICE_IO" --arg tasks "$SLICE_TASKS" \
      '{owner:$owner, slice:("whp-sites-" + $owner + ".slice"),
        cpu:(if $cpu == "" then null else $cpu end), memory_mb:($mem|tonumber? // null),
        io_mbps:($io|tonumber? // null), tasks:($tasks|tonumber? // null)}'
  fi
}

cmd_owner() {
  local domain=${1:-} owner=${2:-}
  [[ -n $domain && -n $owner ]] || usage
  [[ $owner == - ]] && owner=''
  [[ -z $owner ]] || valid_owner "$owner" || die "owner: s<subscription id>, e.g. s12, or -"
  site_load "$domain"
  if [[ ${SITE_OWNER:-} != "$owner" ]]; then
    SITE_OWNER=$owner
    site_save
    # Moving a unit to another slice needs a restart (a few seconds, the socket stays).
    SITE_RESTART=yes site_apply
    user_slice_write
  fi
  ok "$domain runs in $(site_slice)"
  if [[ $JSON == yes ]]; then print_site "$domain"; fi
}

cmd_phpini() {
  local domain=${1:-}; shift || true
  [[ -n $domain ]] || usage
  site_load "$domain"
  local reset=no sets=() kv
  while (($#)); do
    case $1 in
      --set) kv=${2:-}; php_ini_valid "${kv%%=*}" "${kv#*=}" || die "invalid PHP setting: $kv"; sets+=("$kv"); shift ;;
      --reset) reset=yes ;;
      --workers) [[ $2 =~ ^[1-9][0-9]{0,2}$ ]] || die "--workers: 1-999"; SITE_PM_MAX=$2; shift ;;
      --json) ;;
      *) usage ;;
    esac
    shift
  done
  [[ $reset == yes ]] && SITE_PHP_INI=''
  local k pairs=() pair out=''
  for kv in "${sets[@]}"; do
    k=${kv%%=*}
    IFS=';' read -r -a pairs <<<"${SITE_PHP_INI:-}"
    out=''
    for pair in "${pairs[@]}"; do [[ -n $pair && ${pair%%=*} != "$k" ]] && out+="${out:+;}$pair"; done
    SITE_PHP_INI="$out${out:+;}$kv"
  done
  site_save
  site_apply
  ok "$domain PHP settings: ${SITE_PHP_INI:-server defaults}, ${SITE_PM_MAX:-10} workers"
  if [[ $JSON == yes ]]; then print_site "$domain"; fi
}

# Project quota: project id = uid of the site user, applied to the site tree.
# A subdomain site gets the project id of its parent, so its files count towards
# the parent's limit (one quota for the domain and all its subdomains).
quota_tag() {
  local mode=$1 id=$2 dir=$3 mnt
  mnt=$(findmnt -n -o TARGET --target "$dir")
  case $mode in
    ext4) chattr -R +P -p "$id" "$dir" ;;
    xfs) xfs_quota -x -c "project -s -p $dir $id" "$mnt" >/dev/null ;;
  esac
}

quota_apply() {
  local mode id mnt child
  mode=$(quota_mode "$SITE_ROOT")
  if [[ -n ${SITE_PARENT:-} ]]; then
    [[ $mode == none ]] && return 0
    id=$(id -u "$(env_get "$(site_file "$SITE_PARENT")" SITE_USER)")
    quota_tag "$mode" "$id" "$SITE_ROOT"
    return 0
  fi
  id=$(id -u "$SITE_USER")
  mnt=$(findmnt -n -o TARGET --target "$SITE_ROOT")
  if [[ $mode != none ]]; then
    while read -r child; do
      [[ -n $child && -d $WHP_VHOSTS/$child ]] && quota_tag "$mode" "$id" "$WHP_VHOSTS/$child"
    done < <(site_children "$SITE_DOMAIN")
  fi
  case $mode in
    ext4)
      chattr -R +P -p "$id" "$SITE_ROOT"
      setquota -P "$id" 0 $(( SITE_QUOTA_MB * 1024 )) 0 0 "$mnt" ;;
    xfs)
      xfs_quota -x -c "project -s -p $SITE_ROOT $id" "$mnt" >/dev/null
      xfs_quota -x -c "limit -p bhard=${SITE_QUOTA_MB}m $id" "$mnt" ;;
    none)
      warn "no project quota support on $mnt: limit ${SITE_QUOTA_MB} MB is stored but not enforced by the kernel" ;;
  esac
}

cmd_quota() {
  local domain=${1:-} mb=${2:-}
  [[ -n $domain && $mb =~ ^[0-9]+$ ]] || usage
  site_load "$domain"
  [[ -z $SITE_PARENT ]] || die "$domain is a subdomain: it shares the disk quota of $SITE_PARENT"
  SITE_QUOTA_MB=$mb
  site_save
  quota_apply
  ok "$domain quota ${mb} MB ($(quota_mode "$SITE_ROOT"))"
}

cmd_php() {
  local domain=${1:-} v=${2:-}
  [[ -n $domain && $v =~ ^[0-9]+\.[0-9]+$ ]] || usage
  site_load "$domain"
  [[ -x /usr/sbin/php-fpm$v ]] || die "$(t bad_php "$v" "$(installed_php | xargs)")"
  local old=$SITE_PHP
  SITE_PHP=$v
  site_save
  site_apply "$old"
  cache_purge
  ok "$(t site_php "$domain" "$v")"
  if [[ $JSON == yes ]]; then print_site "$domain"; fi
}

cmd_cache() {
  local domain=${1:-} state=${2:-}
  [[ -n $domain && $state =~ ^(on|off|purge)$ ]] || usage
  site_load "$domain"
  cache_purge
  if [[ $state == purge ]]; then
    ok "$domain cache purged"
    if [[ $JSON == yes ]]; then print_site "$domain" 3>&1 | jq '. + {purged:true}' >&3; fi
    return 0
  fi
  SITE_CACHE=$state
  site_save
  site_apply
  ok "$domain cache $state"
  if [[ $JSON == yes ]]; then print_site "$domain"; fi
}

# The whole site is served by an app on 127.0.0.1:<port> (Node.js, Python), or by PHP again.
cmd_proxy() {
  local domain=${1:-} port=${2:-}
  [[ -n $domain && $port =~ ^(off|[0-9]{4,5})$ ]] || usage
  if [[ $port != off ]] && (( port < 1024 || port > 65535 )); then die "proxy: port 1024-65535"; fi
  site_load "$domain"
  if [[ $port == off ]]; then SITE_PROXY=''; else SITE_PROXY=$port; fi
  site_save
  site_apply
  cache_purge
  ok "$domain proxy ${SITE_PROXY:-off}"
  if [[ $JSON == yes ]]; then print_site "$domain"; fi
}

cmd_ssl() {
  local target=${1:-}
  [[ -n $target ]] || usage
  local list=()
  if [[ $target == --pending ]]; then
    local f
    for f in "$SITES_DB"/*.env; do
      [[ -e $f ]] || continue
      case $(env_get "$f" SITE_SSL) in pending|imported) list+=("$(env_get "$f" SITE_DOMAIN)") ;; esac
    done
    # Domain aliases still waiting for their certificate.
    local s a mode www ssl
    for f in "$SITES_DB"/*.env; do
      [[ -e $f ]] || continue
      s=$(env_get "$f" SITE_DOMAIN)
      while read -r a mode www ssl; do
        [[ $ssl == pending ]] || continue
        site_load "$s"
        ALIAS_MODE=$mode ALIAS_WWW=$www ALIAS_SSL=$ssl
        alias_cert "$a"
        alias_put "$s" "$a"
        [[ $ALIAS_SSL == active ]] && site_apply
      done < <(alias_lines "$s")
    done
    # The server hostname itself, when it still runs on a self-signed certificate.
    if [[ -n $WHP_HOSTNAME && ! -e /etc/letsencrypt/live/$WHP_HOSTNAME ]] \
       && [[ $(env_get "$WHP_ETC/installer.env" WHP_LETSENCRYPT 2>/dev/null || echo yes) != no ]]; then
      if "$INSTALLER_DIR/bin/whp-cert" "$WHP_HOSTNAME"; then hostname_cert_installed; fi
    fi
  else
    list=("$target")
  fi
  local import_cert='' import_key='' custom_cert='' custom_key='' custom_chain='' mode=''
  shift
  while (($#)); do
    case $1 in
      --import-cert) import_cert=${2:-}; shift ;;
      --import-key) import_key=${2:-}; shift ;;
      --custom-cert) custom_cert=${2:-}; mode=custom; shift ;;
      --custom-key) custom_key=${2:-}; mode=custom; shift ;;
      --custom-chain) custom_chain=${2:-}; mode=custom; shift ;;
      --wildcard) mode=wildcard ;;
      --letsencrypt) mode=letsencrypt ;;
      --json) ;;
      *) usage ;;
    esac
    shift
  done
  [[ -z $mode || $target != --pending ]] || usage
  local d before
  for d in "${list[@]}"; do
    site_load "$d"
    before=$SITE_SSL
    if [[ -n $import_cert || -n $import_key ]]; then
      [[ $target != --pending ]] || usage
      site_cert_import "$import_cert" "$import_key"
    elif [[ $mode == custom ]]; then
      site_cert_custom "$custom_cert" "$custom_key" "$custom_chain"
    elif [[ $mode == wildcard || ( -z $mode && $SITE_SSL == wildcard ) ]]; then
      site_cert_wildcard
    elif [[ -z $mode && $SITE_SSL == custom ]]; then
      info "$d serves its own certificate: nothing to request"
    else
      site_cert
      if [[ $SITE_SSL == pending && $before =~ ^(custom|wildcard)$ ]]; then
        # Never drop a working certificate because Let's Encrypt cannot issue one yet.
        SITE_SSL=$before
        die "$(t site_cert_pending "$SITE_DOMAIN" "$SITE_DOMAIN") The current certificate stays in use."
      fi
    fi
    site_save
    [[ $before == wildcard && $SITE_SSL != wildcard ]] && wildcard_cleanup "$SITE_DOMAIN"
    if [[ $before == custom && $SITE_SSL =~ ^(active|wildcard)$ ]]; then rm -rf "$(imported_cert_dir "$SITE_DOMAIN")"; fi
    site_apply
    if [[ $JSON == yes && $target != --pending ]]; then print_site "$d"; fi
  done
}

# The hostname got a real certificate: switch panel, Postfix and Dovecot to it.
hostname_cert_installed() {
  local c=/etc/letsencrypt/live/$WHP_HOSTNAME
  sed -i "s#/etc/ssl/certs/ssl-cert-snakeoil.pem#$c/fullchain.pem#; s#/etc/ssl/private/ssl-cert-snakeoil.key#$c/privkey.pem#" \
    /etc/nginx/sites-available/05-whp-panel.conf /etc/dovecot/dovecot.conf 2>/dev/null || true
  if command -v postconf >/dev/null; then
    postconf -e "smtpd_tls_cert_file = $c/fullchain.pem" "smtpd_tls_key_file = $c/privkey.pem"
  fi
  nginx -t >/dev/null 2>&1 && systemctl reload nginx
  local s
  for s in postfix dovecot; do systemctl is-active --quiet "$s" && systemctl reload "$s"; done
  info "$(t cert_ok "$WHP_HOSTNAME")"
}

# Suspend: visitors get a 503 page, PHP-FPM is stopped, the site user cannot
# log in (SFTP/SSH) and its processes are ended. Files, mail and certificates stay.
cmd_suspend() {
  local domain=${1:-} want=${2:-yes}
  [[ -n $domain ]] || usage
  site_load "$domain"
  if [[ ${SITE_SUSPENDED:-no} != "$want" ]]; then
    SITE_SUSPENDED=$want
    site_save
    if [[ $want == yes ]]; then
      usermod --expiredate 1 "$SITE_USER" >/dev/null 2>&1 || true
      site_apply
      pkill -u "$SITE_USER" 2>/dev/null || true
      cache_purge
    else
      usermod --expiredate '' "$SITE_USER" >/dev/null 2>&1 || true
      SITE_RESTART=yes site_apply
    fi
  fi
  if [[ $want == yes ]]; then ok "$(t site_suspended "$domain")"; else ok "$(t site_unsuspended "$domain")"; fi
  # Subdomains follow their main site.
  local child
  if [[ -z ${SITE_PARENT:-} ]]; then
    while read -r child; do
      [[ -n $child ]] && ( JSON=no cmd_suspend "$child" "$want" ) >/dev/null 3>&1
    done < <(site_children "$domain")
  fi
  if [[ $JSON == yes ]]; then print_site "$domain"; fi
}

cmd_refresh() {
  local target=${1:-} list=() f d
  [[ -n $target ]] || usage
  if [[ $target == --all ]]; then
    for f in "$SITES_DB"/*.env; do [[ -e $f ]] && list+=("$(env_get "$f" SITE_DOMAIN)"); done
  else
    list=("$target")
  fi
  for d in "${list[@]}"; do
    site_load "$d"
    site_apply
    user_slice_write
  done
  ok "${#list[@]} site(s) refreshed"
  return 0
}

cmd_remove() {
  local domain=${1:-} keep=no
  [[ -n $domain ]] || usage
  [[ " $* " == *" --keep-files "* ]] && keep=yes
  site_load "$domain"
  local children
  children=$(site_children "$domain" | xargs)
  [[ -z $children ]] || die "$domain still has subdomains ($children): remove those first"
  rm -f "/etc/nginx/sites-enabled/whp-$domain.conf" "/etc/nginx/sites-available/whp-$domain.conf"
  rm -rf "/etc/nginx/whp/sites/$domain"
  nginx -t >>"$WHP_INSTALL_LOG" 2>&1 && systemctl reload nginx
  systemctl disable --now "whp-site-$SITE_ID" >/dev/null 2>&1 || true
  rm -rf "/etc/systemd/system/whp-site-$SITE_ID.service" "/etc/systemd/system/whp-site-$SITE_ID.service.d" \
    "$WHP_ETC/php-fpm/$SITE_ID.conf"
  [[ $keep == yes ]] || rm -f "$WHP_LOG_DIR/php-fpm/$SITE_ID.log"
  systemctl daemon-reload
  pkill -u "$SITE_USER" 2>/dev/null || true
  SITE_OWNER='' user_slice_write
  if [[ $keep == no ]]; then
    rm -rf --one-file-system "${SITE_ROOT:?}"
    certbot delete --non-interactive --cert-name "$domain" >>"$WHP_INSTALL_LOG" 2>&1 || true
  fi
  rm -rf "$(imported_cert_dir "$domain")"
  wildcard_cleanup "$domain"
  local a _m _w _s
  while read -r a _m _w _s; do
    [[ -n $a && $keep == no ]] && { certbot delete --non-interactive --cert-name "$a" >>"$WHP_INSTALL_LOG" 2>&1 || true; }
  done < <(alias_lines "$domain")
  rm -f "$(alias_file "$domain")"
  # Redirects & access (whp-agent webrules.apply): HSTS entry, password files, HTTP flag.
  rm -rf "/etc/nginx/whp/hsts/$domain.conf" "/etc/nginx/whp/auth/$domain" "$SITES_DB/$domain.http-allowed"
  userdel "$SITE_USER" 2>/dev/null || true
  rm -f "$(site_file "$domain")"
  ok "$(t site_removed "$domain")"
  if [[ $JSON == yes ]]; then jq -n --arg d "$domain" '{domain:$d, removed:true}' >&3; fi
}

cmd_list() {
  local f out='[]'
  for f in "$SITES_DB"/*.env; do
    [[ -e $f ]] || continue
    if [[ ${1:-} == --json ]]; then
      out=$(jq -c --argjson s "$(print_site "$(env_get "$f" SITE_DOMAIN)" 3>&1)" '. + [$s]' <<<"$out")
    else
      printf '%-40s php %-4s cache %-3s ssl %s\n' >&3 "$(env_get "$f" SITE_DOMAIN)" "$(env_get "$f" SITE_PHP)" \
        "$(env_get "$f" SITE_CACHE)" "$(env_get "$f" SITE_SSL)"
    fi
  done
  if [[ ${1:-} == --json ]]; then printf '%s\n' "$out" >&3; fi
  return 0
}

# Force HTTPS (default) or also serve the site over plain HTTP.
cmd_https() {
  local domain=${1:-} mode=${2:-}
  [[ -n $domain && $mode =~ ^(force|allow)$ ]] || usage
  site_load "$domain"
  local flag=$SITES_DB/$domain.http-allowed
  if [[ $mode == allow ]]; then install -m 0640 /dev/null "$flag"; else rm -f "$flag"; fi
  site_apply
  ok "$domain https $mode"
  if [[ $JSON == yes ]]; then print_site "$domain" 3>&1 | jq --arg m "$mode" '. + {force_https: ($m == "force")}' >&3; fi
}

cmd=${1:-}; shift || true
case $cmd in
  add) cmd_add "$@" ;;
  php) cmd_php "$@" ;;
  cache) cmd_cache "$@" ;;
  ssl) cmd_ssl "$@" ;;
  cert) cmd_cert "$@" ;;
  quota) cmd_quota "$@" ;;
  limits) cmd_limits "$@" ;;
  owner) cmd_owner "$@" ;;
  slice) cmd_slice "$@" ;;
  phpini) cmd_phpini "$@" ;;
  proxy) cmd_proxy "$@" ;;
  https) cmd_https "$@" ;;
  suspend) cmd_suspend "${1:-}" yes ;;
  unsuspend) cmd_suspend "${1:-}" no ;;
  remove) cmd_remove "$@" ;;
  refresh) cmd_refresh "$@" ;;
  list) cmd_list "$@" ;;
  show) print_site "${1:-}" ;;
  alias) cmd_alias "$@" ;;
  subdomains) [[ -n ${1:-} ]] || usage; site_load "$1"; site_children "$1" >&3 ;;
  *) usage ;;
esac
