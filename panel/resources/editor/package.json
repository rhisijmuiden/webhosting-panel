{
  "name": "whp-code-editor",
  "private": true,
  "description": "CodeMirror 6 bundle for the client file manager. Build: npm ci && npm run build (writes panel/public/assets/editor/codemirror.js).",
  "scripts": {
    "build": "esbuild editor.js --bundle --minify --format=iife --target=es2020 --outfile=../../public/assets/editor/codemirror.js --legal-comments=eof"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.9",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-json": "6.0.1",
    "@codemirror/lang-markdown": "6.3.2",
    "@codemirror/lang-php": "6.0.1",
    "@codemirror/lang-sql": "6.8.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.11.0",
    "@codemirror/legacy-modes": "6.5.1",
    "@codemirror/lint": "6.8.5",
    "@codemirror/search": "6.5.10",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.8",
    "@lezer/highlight": "1.2.1",
    "esbuild": "0.25.4"
  }
}
