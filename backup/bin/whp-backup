#!/usr/bin/env bash
# whp-backup: backup engine of Webhosting Panel.
#
# Wraps restic (encrypted, deduplicated snapshots) and rclone (transport to
# SFTP/SCP, FTP, FTPS, OneDrive or a local/mounted path). Every target is one
# restic repository. Run `whp-backup help` for usage.
#
# Output is human readable by default; pass --json for one JSON document on
# stdout (used by the whp-agent). Logs go to stderr and the log file.

set -Eeuo pipefail
shopt -s nullglob

WHP_BACKUP_VERSION="0.1.0"

WHP_ETC="${WHP_ETC:-/etc/webhosting-panel}"
CONF_DIR="${WHP_BACKUP_CONF_DIR:-$WHP_ETC/backup}"
TARGETS_DIR="$CONF_DIR/targets"
STATE_DIR="${WHP_STATE_DIR:-/var/lib/webhosting-panel}/backup"
LOG_DIR="${WHP_LOG_DIR:-/var/log/webhosting-panel}"
LOG_FILE="$LOG_DIR/backup.log"
LOCK_FILE="${WHP_BACKUP_LOCK:-/run/lock/whp-backup.lock}"

JSON=0
QUIET=0

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------

log() {
	local level="$1"; shift
	local line
	line="$(date -u +%Y-%m-%dT%H:%M:%SZ) [$level] $*"
	if [[ -d "$LOG_DIR" && -w "$LOG_DIR" ]]; then
		printf '%s\n' "$line" >>"$LOG_FILE" 2>/dev/null || true
	fi
	if [[ $QUIET -eq 0 || "$level" == "error" ]]; then
		printf '%s\n' "$line" >&2
	fi
}

die() {
	local code="$1"; shift
	log error "$*"
	if [[ $JSON -eq 1 ]]; then
		jq -cn --arg code "$code" --arg msg "$*" '{ok:false, error:{code:$code, message:$msg}}'
	fi
	exit 1
}

need() {
	local bin
	for bin in "$@"; do
		command -v "$bin" >/dev/null 2>&1 || die missing_dependency "required program not found: $bin"
	done
}

# Print the result: JSON document when --json, otherwise a short human form.
emit() {
	local doc="$1"
	if [[ $JSON -eq 1 ]]; then
		jq -c '{ok:true, data:.}' <<<"$doc"
	else
		jq -r 'if type == "string" then . else . end' <<<"$doc"
	fi
}

valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,39}$ ]]; }
valid_domain() { [[ "$1" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9-]{2,63}$ ]]; }
valid_dbname() { [[ "$1" =~ ^[A-Za-z0-9_]{1,64}$ ]]; }
valid_snapshot() { [[ "$1" =~ ^([0-9a-f]{8}|[0-9a-f]{64}|latest)$ ]]; }

# Read KEY=VALUE files without sourcing them (no code execution).
# Usage: read_kv FILE ARRAYNAME
read_kv() {
	local file="$1" __arr="$2" key value line
	[[ -f "$file" ]] || return 0
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
		[[ "$line" =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]] || continue
		key="${BASH_REMATCH[1]}"
		value="${BASH_REMATCH[2]}"
		# Strip one level of matching quotes.
		if [[ "$value" =~ ^\"(.*)\"$ || "$value" =~ ^\'(.*)\'$ ]]; then
			value="${BASH_REMATCH[1]}"
		fi
		printf -v "${__arr}[$key]" '%s' "$value"
	done <"$file"
}

write_kv() {
	# Usage: write_kv FILE KEY VALUE [KEY VALUE ...]
	local file="$1"; shift
	local tmp
	tmp="$(mktemp "$file.XXXXXX")"
	chmod 600 "$tmp"
	while [[ $# -ge 2 ]]; do
		[[ -n "$2" ]] && printf '%s="%s"\n' "$1" "${2//\"/}" >>"$tmp"
		shift 2
	done
	mv -f "$tmp" "$file"
}

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------

declare -A CFG=(
	[BACKUP_HOST]=""
	[SITES_ROOT]="/var/www/vhosts"
	[MAIL_ROOT]="/var/vmail"
	[SYSTEM_PATHS]="/etc/webhosting-panel /etc/nginx /etc/php /etc/mysql /etc/postfix /etc/dovecot /etc/rspamd /etc/letsencrypt /etc/crowdsec /etc/nftables.conf /etc/unbound /var/lib/webhosting-panel/panel"
	[DATABASES]="yes"
	[DB_EXCLUDE]="information_schema performance_schema sys mysql"
	[MARIADB_DEFAULTS_FILE]=""
	[KEEP_LAST]="3"
	[KEEP_DAILY]="7"
	[KEEP_WEEKLY]="4"
	[KEEP_MONTHLY]="6"
	[KEEP_YEARLY]="0"
	[COMPRESSION]="auto"
	[LIMIT_UPLOAD_KIB]="0"
	[CHECK_READ_DATA_SUBSET]="2%"
	[PRE_RESTORE_SNAPSHOT]="yes"
	[VERIFY_DIR]="/var/lib/webhosting-panel/restore-test"
	[VERIFY_SYSTEM]="yes"
	[VERIFY_SITES]="2"
	[VERIFY_MAIL]="1"
	[VERIFY_DATABASES]="3"
	[VERIFY_KINDS]="both"
	[VERIFY_MAX_AGE_HOURS]="36"
	[VERIFY_MIN_FREE_PERCENT]="10"
	[VERIFY_DB_MEMORY_MB]="256"
	[VERIFY_PHP_LINT]="25"
)

load_config() {
	read_kv "$CONF_DIR/backup.conf" CFG
	[[ -n "${CFG[BACKUP_HOST]}" ]] || CFG[BACKUP_HOST]="$(hostname -f 2>/dev/null || hostname)"
}

declare -A TGT=()

load_target() {
	local name="$1"
	valid_name "$name" || die invalid_params "invalid target name: $name"
	local dir="$TARGETS_DIR/$name"
	[[ -f "$dir/target.conf" ]] || die not_found "target not found: $name"
	TGT=()
	TGT[NAME]="$name"
	TGT[ENABLED]="yes"
	read_kv "$dir/target.conf" TGT
	for k in KEEP_LAST KEEP_DAILY KEEP_WEEKLY KEEP_MONTHLY KEEP_YEARLY; do
		[[ -n "${TGT[$k]:-}" ]] || TGT[$k]="${CFG[$k]}"
	done
	export RCLONE_CONFIG="$dir/rclone.conf"
	export RESTIC_PASSWORD_FILE="$dir/repo.key"
	export RESTIC_REPOSITORY="rclone:remote:${TGT[REMOTE_PATH]}"
	export RESTIC_CACHE_DIR="$STATE_DIR/cache"
	export RESTIC_COMPRESSION="${CFG[COMPRESSION]}"
	unset RESTIC_PASSWORD RESTIC_PASSWORD_COMMAND
	[[ -f "$RESTIC_PASSWORD_FILE" ]] || die not_found "repository key missing for target $name"
}

all_targets() {
	local d
	for d in "$TARGETS_DIR"/*/; do
		d="${d%/}"; d="${d##*/}"
		[[ -f "$TARGETS_DIR/$d/target.conf" ]] && printf '%s\n' "$d"
	done
}

r() {
	# restic with the globally configured options.
	local -a extra=()
	if [[ "${CFG[LIMIT_UPLOAD_KIB]}" != "0" ]]; then
		extra+=(--limit-upload "${CFG[LIMIT_UPLOAD_KIB]}")
	fi
	restic "${extra[@]}" "$@"
}

restic_supports_stdin_command() {
	# --stdin-from-command exists since restic 0.17 (Debian 13 ships 0.18).
	local v
	v="$(restic version 2>/dev/null | awk '{print $2}')"
	[[ -n "$v" ]] || return 1
	local major minor
	IFS=. read -r major minor _ <<<"$v"
	(( major > 0 || minor >= 17 ))
}

# ----------------------------------------------------------------------------
# Lock
# ----------------------------------------------------------------------------

take_lock() {
	mkdir -p "$(dirname "$LOCK_FILE")"
	exec 9>"$LOCK_FILE"
	flock -n 9 || die busy "another whp-backup job is running"
}

# ----------------------------------------------------------------------------
# target subcommands
# ----------------------------------------------------------------------------

cmd_target() {
	local sub="${1:-list}"; shift || true
	case "$sub" in
		add) target_add "$@" ;;
		list) target_list ;;
		show) target_show "$@" ;;
		test) target_test "$@" ;;
		remove) target_remove "$@" ;;
		export-key) target_export_key "$@" ;;
		*) die invalid_params "unknown target command: $sub" ;;
	esac
}

target_add() {
	local name="" type="" host="" port="" user="" path="" password_file="" key_file=""
	local tls_mode="explicit" token_file="" drive_id="" drive_type="" repo_key_file=""
	local insecure_ftp=0 known_hosts_file="" no_init=0 update=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--name) name="$2"; shift 2 ;;
			--type) type="$2"; shift 2 ;;
			--host) host="$2"; shift 2 ;;
			--port) port="$2"; shift 2 ;;
			--user) user="$2"; shift 2 ;;
			--path) path="$2"; shift 2 ;;
			--password-file) password_file="$2"; shift 2 ;;
			--ssh-key) key_file="$2"; shift 2 ;;
			--known-hosts) known_hosts_file="$2"; shift 2 ;;
			--tls) tls_mode="$2"; shift 2 ;;
			--allow-plain-ftp) insecure_ftp=1; shift ;;
			--onedrive-token-file) token_file="$2"; shift 2 ;;
			--onedrive-drive-id) drive_id="$2"; shift 2 ;;
			--onedrive-drive-type) drive_type="$2"; shift 2 ;;
			--repo-key-file) repo_key_file="$2"; shift 2 ;;
			--no-init) no_init=1; shift ;;
			--update) update=1; shift ;;
			*) die invalid_params "unknown option for target add: $1" ;;
		esac
	done

	valid_name "$name" || die invalid_params "--name must match [a-z0-9][a-z0-9_-]{0,39}"
	[[ -n "$path" ]] || die invalid_params "--path is required"
	[[ "$path" != *$'\n'* && "$path" != *'"'* ]] || die invalid_params "invalid --path"
	local dir="$TARGETS_DIR/$name"
	if [[ -e "$dir" && $update -eq 0 ]]; then
		die conflict "target already exists: $name (use --update)"
	fi

	local tmpdir
	tmpdir="$(mktemp -d "$TARGETS_DIR/.new-$name.XXXXXX")"
	chmod 700 "$tmpdir"
	# shellcheck disable=SC2064
	trap "rm -rf '$tmpdir'" EXIT

	local rc="$tmpdir/rclone.conf"
	local -a opts=()
	local pass=""
	if [[ -n "$password_file" ]]; then
		[[ -r "$password_file" ]] || die invalid_params "cannot read --password-file"
		pass="$(head -n1 "$password_file")"
	fi

	case "$type" in
		sftp|scp)
			[[ -n "$host" && -n "$user" ]] || die invalid_params "--host and --user are required for $type"
			[[ -n "$key_file" || -n "$pass" ]] || die invalid_params "--ssh-key or --password-file is required for $type"
			port="${port:-22}"
			opts+=(host "$host" port "$port" user "$user")
			if [[ -n "$key_file" ]]; then
				[[ -r "$key_file" ]] || die invalid_params "cannot read --ssh-key"
				install -m 600 "$key_file" "$tmpdir/id_key"
				opts+=(key_file "$dir/id_key")
			fi
			[[ -n "$pass" ]] && opts+=(pass "$(rclone obscure "$pass")")
			# Pin the host key: given file, else trust on first use.
			if [[ -n "$known_hosts_file" ]]; then
				install -m 600 "$known_hosts_file" "$tmpdir/known_hosts"
			else
				need ssh-keyscan
				ssh-keyscan -p "$port" -T 10 "$host" >"$tmpdir/known_hosts" 2>/dev/null \
					|| die unreachable "could not read the SSH host key of $host:$port"
				[[ -s "$tmpdir/known_hosts" ]] || die unreachable "no SSH host key received from $host:$port"
				log info "pinned SSH host key of $host:$port (trust on first use)"
			fi
			opts+=(known_hosts_file "$dir/known_hosts" shell_type unix)
			type="sftp"
			;;
		ftp|ftps)
			[[ -n "$host" && -n "$user" && -n "$pass" ]] || die invalid_params "--host, --user and --password-file are required for $type"
			opts+=(host "$host" user "$user" pass "$(rclone obscure "$pass")")
			if [[ "$type" == "ftps" ]]; then
				case "$tls_mode" in
					explicit) opts+=(explicit_tls true); port="${port:-21}" ;;
					implicit) opts+=(tls true); port="${port:-990}" ;;
					*) die invalid_params "--tls must be explicit or implicit" ;;
				esac
			else
				[[ $insecure_ftp -eq 1 ]] || die invalid_params "plain FTP sends the password unencrypted; use ftps or pass --allow-plain-ftp"
				port="${port:-21}"
			fi
			opts+=(port "$port")
			;;
		onedrive)
			[[ -n "$token_file" ]] || die invalid_params "--onedrive-token-file is required (output of: rclone authorize onedrive)"
			jq -e '.access_token and .refresh_token' "$token_file" >/dev/null 2>&1 \
				|| die invalid_params "the OneDrive token file is not valid JSON from rclone authorize"
			opts+=(token "$(jq -c . "$token_file")")
			[[ -n "$drive_id" ]] && opts+=(drive_id "$drive_id")
			opts+=(drive_type "${drive_type:-personal}")
			;;
		local)
			;;
		*) die invalid_params "--type must be one of: sftp, scp, ftp, ftps, onedrive, local" ;;
	esac

	: >"$rc"; chmod 600 "$rc"
	RCLONE_CONFIG="$rc" rclone config create remote "$type" "${opts[@]}" --non-interactive >/dev/null \
		|| die config_error "rclone could not create the remote"
	# Paths inside rclone.conf must point at the final directory.
	if [[ -n "$repo_key_file" ]]; then
		[[ -r "$repo_key_file" ]] || die invalid_params "cannot read --repo-key-file"
		install -m 600 "$repo_key_file" "$tmpdir/repo.key"
	elif [[ $update -eq 1 && -f "$dir/repo.key" ]]; then
		install -m 600 "$dir/repo.key" "$tmpdir/repo.key"
	else
		umask 077
		head -c 48 /dev/urandom | base64 -w0 >"$tmpdir/repo.key"
		printf '\n' >>"$tmpdir/repo.key"
	fi
	write_kv "$tmpdir/target.conf" \
		TYPE "$type" HOST "$host" PORT "$port" USER "$user" REMOTE_PATH "$path" ENABLED yes \
		CREATED "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

	if [[ $update -eq 1 && -d "$dir" ]]; then
		rm -rf "$dir.old"
		mv "$dir" "$dir.old"
	fi
	mv "$tmpdir" "$dir"
	rm -rf "$dir.old"
	trap - EXIT

	load_target "$name"
	local initialized="false"
	if [[ $no_init -eq 0 ]]; then
		if restic cat config >/dev/null 2>&1; then
			log info "target $name: existing repository found, key accepted"
		else
			if [[ -n "$repo_key_file" ]]; then
				die repo_error "no repository readable at the target with the given key"
			fi
			restic init >/dev/null || die repo_error "could not initialise the repository on target $name"
			log info "target $name: new repository initialised"
		fi
		initialized="true"
	fi
	emit "$(target_json "$name" | jq --argjson init "$initialized" '. + {initialized:$init}')"
}

target_json() {
	load_target "$1"
	jq -n --arg name "$1" --arg type "${TGT[TYPE]}" --arg host "${TGT[HOST]:-}" \
		--arg port "${TGT[PORT]:-}" --arg user "${TGT[USER]:-}" --arg path "${TGT[REMOTE_PATH]}" \
		--arg enabled "${TGT[ENABLED]}" --arg created "${TGT[CREATED]:-}" \
		'{name:$name, type:$type, host:$host, port:$port, user:$user, path:$path,
		  enabled:($enabled == "yes"), created:$created}'
}

target_list() {
	local doc="[]" t
	while IFS= read -r t; do
		doc="$(jq --argjson t "$(target_json "$t")" '. + [$t]' <<<"$doc")"
	done < <(all_targets)
	if [[ $JSON -eq 1 ]]; then
		emit "$doc"
	else
		jq -r '.[] | "\(.name)\t\(.type)\t\(.host)\t\(.path)\t\(if .enabled then "enabled" else "disabled" end)"' <<<"$doc"
	fi
}

target_show() { emit "$(target_json "${1:?target name}")"; }

target_test() {
	local name="${1:?target name}"
	load_target "$name"
	local start end ok="true" message="reachable" repo="false"
	start="$(date +%s%N)"
	if ! rclone lsf "remote:${TGT[REMOTE_PATH]}" --max-depth 1 >/dev/null 2>&1; then
		if ! rclone mkdir "remote:${TGT[REMOTE_PATH]}" >/dev/null 2>&1; then
			ok="false"; message="cannot connect or path not writable"
		fi
	fi
	if [[ "$ok" == "true" ]] && restic cat config >/dev/null 2>&1; then
		repo="true"
	fi
	end="$(date +%s%N)"
	emit "$(jq -n --arg name "$name" --argjson ok "$ok" --argjson repo "$repo" --arg msg "$message" \
		--argjson ms "$(( (end - start) / 1000000 ))" \
		'{target:$name, reachable:$ok, repository:$repo, message:$msg, duration_ms:$ms}')"
	[[ "$ok" == "true" ]]
}

target_remove() {
	local name="${1:?target name}"
	valid_name "$name" || die invalid_params "invalid target name"
	[[ -d "$TARGETS_DIR/$name" ]] || die not_found "target not found: $name"
	# Only the local configuration is removed; remote data stays.
	rm -rf "${TARGETS_DIR:?}/$name"
	emit "$(jq -n --arg name "$name" '{removed:$name, remote_data_kept:true}')"
}

target_export_key() {
	local name="${1:?target name}"
	load_target "$name"
	emit "$(jq -n --arg name "$name" --arg key "$(head -n1 "$RESTIC_PASSWORD_FILE")" '{target:$name, repository_key:$key}')"
}

# ----------------------------------------------------------------------------
# Scopes: what to back up
# ----------------------------------------------------------------------------

list_sites() {
	local d
	[[ -d "${CFG[SITES_ROOT]}" ]] || return 0
	for d in "${CFG[SITES_ROOT]}"/*/; do
		d="${d%/}"; d="${d##*/}"
		valid_domain "$d" && printf 'site:%s\n' "$d"
	done
}

list_mail() {
	local d
	[[ -d "${CFG[MAIL_ROOT]}" ]] || return 0
	for d in "${CFG[MAIL_ROOT]}"/*/; do
		d="${d%/}"; d="${d##*/}"
		valid_domain "$d" && printf 'mail:%s\n' "$d"
	done
}

mariadb_cmd() {
	local bin="$1"; shift
	local -a a=("$bin")
	[[ -n "${CFG[MARIADB_DEFAULTS_FILE]}" ]] && a+=("--defaults-extra-file=${CFG[MARIADB_DEFAULTS_FILE]}")
	printf '%s\n' "${a[@]}" "$@"
}

list_databases() {
	[[ "${CFG[DATABASES]}" == "yes" ]] || return 0
	command -v mariadb >/dev/null 2>&1 || { log warn "mariadb client not found, skipping databases"; return 0; }
	local -a cmd
	mapfile -t cmd < <(mariadb_cmd mariadb -N -B -e "SHOW DATABASES")
	local db ex skip
	while IFS= read -r db; do
		skip=0
		for ex in ${CFG[DB_EXCLUDE]}; do [[ "$db" == "$ex" ]] && skip=1; done
		[[ $skip -eq 0 ]] && valid_dbname "$db" && printf 'db:%s\n' "$db"
	done < <("${cmd[@]}" 2>/dev/null || log warn "could not list databases")
}

validate_scopes() {
	local s
	for s in "$@"; do
		case "$s" in
			all|system|sites|mail|databases) ;;
			site:*|mail:*) valid_domain "${s#*:}" || die invalid_params "invalid domain in scope $s" ;;
			db:*) valid_dbname "${s#db:}" || die invalid_params "invalid database in scope $s" ;;
			*) die invalid_params "unknown scope: $s" ;;
		esac
	done
}

# Expand --scope values into a list of concrete items (validated first).
expand_scopes() {
	local s
	for s in "$@"; do
		case "$s" in
			all) printf 'system\n'; list_sites; list_mail; list_databases ;;
			system) printf 'system\n' ;;
			sites) list_sites ;;
			mail) list_mail ;;
			databases) list_databases ;;
			site:*) valid_domain "${s#site:}" || die invalid_params "invalid domain in $s"; printf '%s\n' "$s" ;;
			mail:*) valid_domain "${s#mail:}" || die invalid_params "invalid domain in $s"; printf '%s\n' "$s" ;;
			db:*) valid_dbname "${s#db:}" || die invalid_params "invalid database in $s"; printf '%s\n' "$s" ;;
			*) die invalid_params "unknown scope: $s" ;;
		esac
	done | awk '!seen[$0]++'
}

scope_paths() {
	local item="$1" p
	case "$item" in
		system)
			for p in ${CFG[SYSTEM_PATHS]}; do [[ -e "$p" ]] && printf '%s\n' "$p"; done ;;
		site:*) printf '%s\n' "${CFG[SITES_ROOT]}/${item#site:}" ;;
		mail:*) printf '%s\n' "${CFG[MAIL_ROOT]}/${item#mail:}" ;;
	esac
}

# ----------------------------------------------------------------------------
# run
# ----------------------------------------------------------------------------

summary_json() {
	# Pick restic's summary line out of --json output.
	jq -c 'select(.message_type == "summary")
		| {snapshot_id, files_new, files_changed, files_unmodified,
		   data_added, total_bytes_processed, duration:.total_duration}' 2>/dev/null | tail -n1
}

backup_item() {
	local item="$1" kind="$2"
	local -a tags=(--tag whp --tag "kind:$kind" --tag "scope:$item" --host "${CFG[BACKUP_HOST]}")
	local out rc=0
	case "$item" in
		db:*)
			local db="${item#db:}"
			local -a dump
			mapfile -t dump < <(mariadb_cmd mariadb-dump --single-transaction --quick --routines \
				--triggers --events --hex-blob --default-character-set=utf8mb4 -- "$db")
			if restic_supports_stdin_command; then
				out="$(r backup --json "${tags[@]}" --stdin-filename "databases/$db.sql" \
					--stdin-from-command -- "${dump[@]}" 2>>"$STATE_DIR/restic.err")" || rc=$?
			else
				local -a st
				out="$("${dump[@]}" 2>>"$STATE_DIR/restic.err" | r backup --json "${tags[@]}" \
					--stdin --stdin-filename "databases/$db.sql" 2>>"$STATE_DIR/restic.err"; \
					printf '\n#PIPE %s %s' "${PIPESTATUS[0]}" "${PIPESTATUS[1]}")" || true
				read -r -a st <<<"$(grep -o '#PIPE [0-9]* [0-9]*$' <<<"$out" | cut -d' ' -f2-)"
				out="$(sed '$d' <<<"$out")"
				if [[ "${st[0]:-1}" != "0" ]]; then
					rc=1
					local sid
					sid="$(summary_json <<<"$out" | jq -r '.snapshot_id // empty')"
					if [[ -n "$sid" ]]; then r forget "$sid" >/dev/null 2>&1 || true; fi
				elif [[ "${st[1]:-1}" != "0" ]]; then
					rc=1
				fi
			fi
			;;
		*)
			local -a paths
			mapfile -t paths < <(scope_paths "$item")
			if [[ ${#paths[@]} -eq 0 ]]; then
				jq -cn --arg item "$item" '{scope:$item, status:"skipped", reason:"nothing to back up"}'
				return 0
			fi
			local -a extra=(--one-file-system --exclude-caches)
			[[ -f "$CONF_DIR/excludes.txt" ]] && extra+=(--exclude-file "$CONF_DIR/excludes.txt")
			[[ "$kind" == "full" ]] && extra+=(--force)
			out="$(r backup --json "${tags[@]}" "${extra[@]}" -- "${paths[@]}" 2>>"$STATE_DIR/restic.err")" || rc=$?
			# restic exits 3 when some files could not be read; snapshot exists.
			;;
	esac
	local sum
	sum="$(summary_json <<<"$out")"
	if [[ $rc -eq 0 && -n "$sum" ]]; then
		jq -c --arg item "$item" '{scope:$item, status:"ok"} + .' <<<"$sum"
	elif [[ $rc -eq 3 && -n "$sum" ]]; then
		jq -c --arg item "$item" '{scope:$item, status:"warning", reason:"some files could not be read"} + .' <<<"$sum"
	else
		jq -cn --arg item "$item" --arg rc "$rc" --arg err "$(tail -n3 "$STATE_DIR/restic.err" 2>/dev/null)" \
			'{scope:$item, status:"failed", exit_code:($rc|tonumber), reason:$err}'
	fi
}

cmd_run() {
	local kind="incremental" target="" prune=0
	local -a scopes=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--full) kind="full"; shift ;;
			--incremental) kind="incremental"; shift ;;
			--target) target="$2"; shift 2 ;;
			--scope) scopes+=("$2"); shift 2 ;;
			--prune) prune=1; shift ;;
			*) die invalid_params "unknown option for run: $1" ;;
		esac
	done
	[[ ${#scopes[@]} -gt 0 ]] || scopes=(all)
	validate_scopes "${scopes[@]}"
	take_lock
	mkdir -p "$STATE_DIR"
	: >"$STATE_DIR/restic.err"

	local -a targets items
	if [[ -n "$target" ]]; then
		targets=("$target")
	else
		mapfile -t targets < <(all_targets)
	fi
	[[ ${#targets[@]} -gt 0 ]] || die not_found "no backup targets configured"
	mapfile -t items < <(expand_scopes "${scopes[@]}")

	local started finished t item res status="ok" runs="[]" results
	started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	for t in "${targets[@]}"; do
		load_target "$t"
		if [[ "${TGT[ENABLED]}" != "yes" && -z "$target" ]]; then
			continue
		fi
		log info "target $t: $kind backup of ${#items[@]} item(s)"
		results="[]"
		for item in "${items[@]}"; do
			res="$(backup_item "$item" "$kind")"
			log info "target $t: $(jq -r '"\(.scope) \(.status)"' <<<"$res")"
			results="$(jq --argjson r "$res" '. + [$r]' <<<"$results")"
		done
		local pruned="null"
		if [[ $prune -eq 1 ]]; then
			if forget_target >/dev/null; then pruned="true"; else pruned="false"; fi
		fi
		runs="$(jq --arg t "$t" --argjson res "$results" --argjson pruned "$pruned" \
			'. + [{target:$t, items:$res, pruned:$pruned}]' <<<"$runs")"
	done
	finished="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	if jq -e '[.[].items[] | select(.status == "failed")] | length > 0' <<<"$runs" >/dev/null; then
		status="failed"
	elif jq -e '[.[].items[] | select(.status == "warning")] | length > 0' <<<"$runs" >/dev/null; then
		status="warning"
	fi
	local doc
	doc="$(jq -n --arg kind "$kind" --arg s "$started" --arg f "$finished" --arg st "$status" \
		--arg host "${CFG[BACKUP_HOST]}" --argjson runs "$runs" \
		'{kind:$kind, status:$st, host:$host, started:$s, finished:$f, targets:$runs}')"
	printf '%s\n' "$doc" >"$STATE_DIR/last-run.json.tmp" && mv -f "$STATE_DIR/last-run.json.tmp" "$STATE_DIR/last-run.json"
	if [[ $JSON -eq 1 ]]; then
		emit "$doc"
	else
		jq -r '"\(.kind) backup \(.status) (\(.started) - \(.finished))",
			(.targets[] | .target as $t | .items[] | "  \($t)  \(.scope)  \(.status)  \(.data_added // 0) bytes added")' <<<"$doc"
	fi
	[[ "$status" != "failed" ]]
}

# ----------------------------------------------------------------------------
# snapshots
# ----------------------------------------------------------------------------

snapshots_json() {
	# Args: restic snapshot filters, or a snapshot id.
	# Note: several --tag options are OR-ed by restic, so pass one at most.
	r snapshots --json "$@" | jq -c '[ .[] | select(any(.tags[]?; . == "whp")) | {
		id, short_id, time, host: .hostname, paths,
		kind: ([.tags[]? | select(startswith("kind:")) | ltrimstr("kind:")][0] // "unknown"),
		scope: ([.tags[]? | select(startswith("scope:")) | ltrimstr("scope:")][0] // "unknown"),
		size: (.summary.total_bytes_processed // null)
	} ] | sort_by(.time) | reverse'
}

cmd_snapshots() {
	local target="" scope="" host=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--target) target="$2"; shift 2 ;;
			--scope) scope="$2"; shift 2 ;;
			--host) host="$2"; shift 2 ;;
			*) die invalid_params "unknown option for snapshots: $1" ;;
		esac
	done
	[[ -n "$target" ]] || die invalid_params "--target is required"
	load_target "$target"
	local -a f=(--tag whp)
	if [[ -n "$scope" ]]; then
		[[ "$scope" =~ ^(system|(site|mail):[a-z0-9.-]+|db:[A-Za-z0-9_]+)$ ]] || die invalid_params "invalid --scope"
		f=(--tag "whp,scope:$scope")
	fi
	[[ -n "$host" ]] && f+=(--host "$host")
	local doc
	doc="$(snapshots_json "${f[@]}")" || die repo_error "could not list snapshots on target $target"
	if [[ $JSON -eq 1 ]]; then
		emit "$doc"
	else
		jq -r '.[] | "\(.short_id)  \(.time[0:19])  \(.kind)\t\(.scope)\t\(.host)"' <<<"$doc"
	fi
}

# ----------------------------------------------------------------------------
# restore
# ----------------------------------------------------------------------------

cmd_restore() {
	local target="" snap="" to="" in_place=0 database="" include=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--target) target="$2"; shift 2 ;;
			--snapshot) snap="$2"; shift 2 ;;
			--to) to="$2"; shift 2 ;;
			--in-place) in_place=1; shift ;;
			--database) database="$2"; shift 2 ;;
			--include) include="$2"; shift 2 ;;
			*) die invalid_params "unknown option for restore: $1" ;;
		esac
	done
	[[ -n "$target" && -n "$snap" ]] || die invalid_params "--target and --snapshot are required"
	valid_snapshot "$snap" || die invalid_params "invalid --snapshot"
	[[ $in_place -eq 1 || -n "$to" ]] || die invalid_params "choose --to DIR or --in-place"
	[[ $in_place -eq 1 && -n "$to" ]] && die invalid_params "--to and --in-place cannot be combined"
	[[ -z "$database" ]] || valid_dbname "$database" || die invalid_params "invalid --database"
	if [[ -n "$include" ]]; then
		[[ "$include" == /* && "$include" != *..* ]] || die invalid_params "--include must be an absolute path without .."
	fi

	load_target "$target"
	take_lock
	mkdir -p "$STATE_DIR"

	local meta
	meta="$(snapshots_json "$snap" | jq -c '.[0] // empty')" || true
	[[ -n "$meta" ]] || die not_found "snapshot $snap not found on target $target"
	local scope id
	scope="$(jq -r .scope <<<"$meta")"
	id="$(jq -r .id <<<"$meta")"
	log info "restore $scope from snapshot ${id:0:8} on target $target"

	local result
	case "$scope" in
		db:*)
			result="$(restore_db "$id" "${scope#db:}" "$database" "$to" "$in_place")" ;;
		system|site:*|mail:*)
			result="$(restore_files "$id" "$scope" "$to" "$in_place" "$include")" ;;
		*) die unsupported "snapshot $snap has no known scope" ;;
	esac
	emit "$(jq -c --argjson meta "$meta" '{snapshot:$meta} + .' <<<"$result")"
}

restore_db() {
	local id="$1" orig="$2" database="$3" to="$4" in_place="$5"
	local name="${database:-$orig}"
	if [[ -n "$to" ]]; then
		mkdir -p "$to"
		r dump "$id" "/databases/$orig.sql" >"$to/$orig.sql" || die restore_failed "could not read the dump"
		jq -cn --arg f "$to/$orig.sql" '{restored:"file", path:$f}'
		return
	fi
	need mariadb
	local -a cli
	mapfile -t cli < <(mariadb_cmd mariadb)
	if [[ "${CFG[PRE_RESTORE_SNAPSHOT]}" == "yes" && "$name" == "$orig" ]]; then
		local pre
		pre="$(backup_item "db:$name" pre-restore)"
		[[ "$(jq -r .status <<<"$pre")" == "ok" ]] || log warn "pre-restore snapshot of db:$name failed"
	fi
	"${cli[@]}" -e "CREATE DATABASE IF NOT EXISTS \`$name\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci" \
		|| die restore_failed "could not create database $name"
	set +e
	r dump "$id" "/databases/$orig.sql" | "${cli[@]}" "$name"
	local -a st=("${PIPESTATUS[@]}")
	set -e
	[[ "${st[0]}" == "0" && "${st[1]}" == "0" ]] || die restore_failed "database import failed (restic ${st[0]}, mariadb ${st[1]})"
	jq -cn --arg db "$name" '{restored:"database", database:$db}'
}

restore_files() {
	local id="$1" scope="$2" to="$3" in_place="$4" include="$5"
	local -a inc=()
	[[ -n "$include" ]] && inc+=(--include "$include")
	if [[ -n "$to" ]]; then
		[[ "$to" == /* ]] || die invalid_params "--to must be an absolute path"
		mkdir -p "$to"
		r restore "$id" --target "$to" "${inc[@]}" >/dev/null 2>>"$STATE_DIR/restic.err" \
			|| die restore_failed "restic restore failed: $(tail -n1 "$STATE_DIR/restic.err")"
		jq -cn --arg to "$to" '{restored:"files", mode:"copy", path:$to}'
		return
	fi

	# In place: snapshot the current state first, restore into staging and
	# mirror with rsync so files created after the backup are removed too.
	need rsync
	local pre_id=""
	if [[ "${CFG[PRE_RESTORE_SNAPSHOT]}" == "yes" ]]; then
		local pre
		pre="$(backup_item "$scope" pre-restore)"
		pre_id="$(jq -r '.snapshot_id // empty' <<<"$pre")"
		[[ -n "$pre_id" ]] || log warn "pre-restore snapshot of $scope failed or had nothing to save"
	fi
	local stage="$STATE_DIR/restore-staging/${id:0:12}"
	rm -rf "$stage"; mkdir -p "$stage"
	r restore "$id" --target "$stage" "${inc[@]}" >/dev/null 2>>"$STATE_DIR/restic.err" \
		|| die restore_failed "restic restore failed: $(tail -n1 "$STATE_DIR/restic.err")"
	local -a paths
	mapfile -t paths < <(r snapshots --json "$id" | jq -r '.[0].paths[]')
	local p src
	for p in "${paths[@]}"; do
		if [[ -n "$include" ]]; then
			# Partial restore: only mirror the included sub path.
			[[ "$include" == "$p" || "$include" == "$p/"* ]] || continue
			p="$include"
		fi
		src="$stage$p"
		[[ -e "$src" ]] || continue
		if [[ -d "$src" ]]; then
			mkdir -p "$p"
			rsync -aHAX --numeric-ids --delete "$src/" "$p/"
		else
			mkdir -p "$(dirname "$p")"
			rsync -aHAX --numeric-ids "$src" "$p"
		fi
	done
	rm -rf "$stage"
	jq -cn --arg pre "$pre_id" --argjson paths "$(printf '%s\n' "${paths[@]}" | jq -R . | jq -s .)" \
		'{restored:"files", mode:"in-place", paths:$paths, pre_restore_snapshot:(if $pre == "" then null else $pre end)}'
}

# ----------------------------------------------------------------------------
# verify: automatic restore tests
#
# Restores a sample of the newest restore points from a remote location into
# an isolated scratch folder (never over live data), checks that the result
# is complete and readable, and removes it again. Databases are imported into
# a private, throw-away MariaDB instance (own data directory, unix socket
# only, no network) so a restore test never touches the live databases.
# ----------------------------------------------------------------------------

VERIFY_RUN_DIR=""
VERIFY_DB_DIR=""
VERIFY_DB_READY=0
# restic times carry the local offset (2026-11-06T02:30:00.123+01:00); jq's
# strptime ignores offsets, so they are applied by hand.
JQ_EPOCH='def epoch: (.[0:19] | strptime("%Y-%m-%dT%H:%M:%S") | mktime)
	- ((capture("(?<s>[+-])(?<h>[0-9]{2}):?(?<m>[0-9]{2})$") // {s: "+", h: "00", m: "00"})
	   | ((.h | tonumber) * 3600 + (.m | tonumber) * 60) * (if .s == "-" then -1 else 1 end)); '

VERIFY_DB_PID=""

verify_cleanup() {
	if [[ -n "$VERIFY_DB_DIR" ]]; then
		if [[ -S "$VERIFY_DB_DIR/mysqld.sock" ]]; then
			mariadb-admin --no-defaults --socket="$VERIFY_DB_DIR/mysqld.sock" -uroot shutdown >/dev/null 2>&1 || true
		fi
		if [[ -n "$VERIFY_DB_PID" ]]; then
			local i
			for i in $(seq 1 30); do kill -0 "$VERIFY_DB_PID" 2>/dev/null || break; sleep 1; done
			kill -9 "$VERIFY_DB_PID" 2>/dev/null || true
		fi
	fi
	if [[ -n "$VERIFY_RUN_DIR" && -d "$VERIFY_RUN_DIR" ]]; then
		rm -rf --one-file-system "$VERIFY_RUN_DIR"
	fi
	VERIFY_DB_DIR="" VERIFY_DB_PID="" VERIFY_RUN_DIR=""
}

# Free bytes on the file system of the scratch folder.
verify_free_bytes() { df -PB1 "${CFG[VERIFY_DIR]}" | awk 'NR==2 {print $4}'; }

# Start the private MariaDB instance (once per run, in the main shell so the
# item tests in subshells share it). Returns 1 when it cannot be started; the
# dumps are then only checked as files.
verify_db_start() {
	[[ -n "$VERIFY_DB_PID" ]] && return 0
	command -v mariadbd >/dev/null 2>&1 || command -v mysqld >/dev/null 2>&1 || return 1
	command -v mariadb-install-db >/dev/null 2>&1 || return 1
	local server owner="mysql"
	server="$(command -v mariadbd || command -v mysqld)"
	id "$owner" >/dev/null 2>&1 || owner="root"
	VERIFY_DB_DIR="$VERIFY_RUN_DIR/mariadb"
	mkdir -p "$VERIFY_DB_DIR/data" "$VERIFY_DB_DIR/tmp"
	chown -R "$owner:" "$VERIFY_DB_DIR"
	chmod 700 "$VERIFY_DB_DIR"
	mariadb-install-db --no-defaults --user="$owner" --datadir="$VERIFY_DB_DIR/data" \
		--auth-root-authentication-method=normal --skip-test-db >"$VERIFY_DB_DIR/install.log" 2>&1 || return 1
	"$server" --no-defaults --user="$owner" --datadir="$VERIFY_DB_DIR/data" --tmpdir="$VERIFY_DB_DIR/tmp" \
		--socket="$VERIFY_DB_DIR/mysqld.sock" --pid-file="$VERIFY_DB_DIR/mysqld.pid" \
		--skip-networking --skip-grant-tables --skip-log-bin --skip-name-resolve \
		--innodb-buffer-pool-size="${CFG[VERIFY_DB_MEMORY_MB]}M" --innodb-log-file-size=64M \
		--innodb-flush-log-at-trx-commit=0 --innodb-doublewrite=0 --max-allowed-packet=1G \
		--log-error="$VERIFY_DB_DIR/error.log" >/dev/null 2>&1 &
	# shellcheck disable=SC2128 # false positive on $!
	VERIFY_DB_PID=$!
	local i
	for i in $(seq 1 60); do
		if mariadb-admin --no-defaults --socket="$VERIFY_DB_DIR/mysqld.sock" -uroot ping >/dev/null 2>&1; then
			VERIFY_DB_READY=1
			log info "private MariaDB instance for restore tests started"
			return 0
		fi
		kill -0 "$VERIFY_DB_PID" 2>/dev/null || break
		sleep 1
	done
	log warn "the private MariaDB instance for restore tests did not start: $(tail -n2 "$VERIFY_DB_DIR/error.log" 2>/dev/null)"
	return 1
}

verify_sql() {
	# Run SQL in the private instance. Usage: verify_sql [db] < sql | verify_sql -e "..."
	local -a a=(mariadb --no-defaults --socket="$VERIFY_DB_DIR/mysqld.sock" -uroot -N -B)
	# Never let a dump run client commands (\! shell, source files).
	mariadb --help 2>/dev/null | grep -q -- '--sandbox' && a+=(--sandbox)
	"${a[@]}" "$@"
}

# One check result as JSON: verify_check NAME OK(true|false|warn) DETAIL
verify_check() {
	jq -cn --arg c "$1" --arg s "$2" --arg d "${3:-}" \
		'{check:$c, result:(if $s == "true" then "ok" elif $s == "warn" then "warning" else "failed" end), detail:$d}'
}

# Restore one file snapshot into the scratch folder and check it.
verify_files() {
	local id="$1" scope="$2" dir="$3"
	local -a checks=()
	local lsout expected
	if ! lsout="$(r ls --json "$id" 2>>"$STATE_DIR/restic.err")"; then
		checks+=("$(verify_check listing false "could not read the file list of the snapshot: $(tail -n1 "$STATE_DIR/restic.err")")")
		printf '%s\n' "${checks[@]}" | jq -cs '{checks:., files:null, bytes:null}'
		return
	fi
	expected="$(jq -cs '[.[] | select(.struct_type == "node")]
		| {files: ([.[] | select(.type == "file")] | length),
		   bytes: ([.[] | select(.type == "file") | .size // 0] | add // 0),
		   dirs: ([.[] | select(.type == "dir")] | length),
		   links: ([.[] | select(.type == "symlink")] | length)}' <<<"$lsout")"
	lsout=""
	local efiles ebytes elinks
	efiles="$(jq -r .files <<<"$expected")"
	ebytes="$(jq -r .bytes <<<"$expected")"
	elinks="$(jq -r .links <<<"$expected")"
	checks+=("$(verify_check listing true "$efiles files, $ebytes bytes in the snapshot")")

	# Enough room? Keep VERIFY_MIN_FREE_PERCENT of the disk free after the restore.
	local free total need
	free="$(verify_free_bytes)"
	total="$(df -PB1 "${CFG[VERIFY_DIR]}" | awk 'NR==2 {print $2}')"
	need=$(( ebytes + total * CFG[VERIFY_MIN_FREE_PERCENT] / 100 ))
	if (( need > free )); then
		checks+=("$(verify_check disk_space warn "not enough free space to restore $ebytes bytes (free: $free)")")
		printf '%s\n' "${checks[@]}" | jq -cs --argjson e "$expected" '{checks:., files:$e.files, bytes:$e.bytes, skipped:"disk_space"}'
		return
	fi

	mkdir -p "$dir"
	chmod 700 "$dir"
	if r restore "$id" --target "$dir" --verify >/dev/null 2>>"$STATE_DIR/restic.err"; then
		checks+=("$(verify_check restore true "downloaded, decrypted and every file content verified")")
	else
		checks+=("$(verify_check restore false "restic restore failed: $(tail -n1 "$STATE_DIR/restic.err")")")
	fi

	local afiles abytes alinks
	afiles="$(find "$dir" -type f | wc -l)"
	abytes="$(find "$dir" -type f -printf '%s\n' | awk '{s += $1} END {printf "%d", s}')"
	alinks="$(find "$dir" -type l | wc -l)"
	if [[ "$afiles" == "$efiles" && "$abytes" == "$ebytes" ]]; then
		checks+=("$(verify_check complete true "$afiles files and $abytes bytes restored, as in the backup")")
	else
		checks+=("$(verify_check complete false "restored $afiles of $efiles files, $abytes of $ebytes bytes")")
	fi
	if [[ "$alinks" != "$elinks" ]]; then
		checks+=("$(verify_check symlinks false "restored $alinks of $elinks symbolic links")")
	fi

	case "$scope" in
		site:*)
			# Website code must still parse (catches truncated or damaged files).
			if command -v php >/dev/null 2>&1; then
				local -a php_files
				mapfile -t php_files < <(find "$dir" -type f -name '*.php' -size -2M 2>/dev/null | shuf -n "${CFG[VERIFY_PHP_LINT]}" 2>/dev/null)
				if [[ ${#php_files[@]} -gt 0 ]]; then
					local f bad=0 first=""
					for f in "${php_files[@]}"; do
						if ! php -n -l "$f" >/dev/null 2>&1; then
							bad=$((bad + 1)); [[ -n "$first" ]] || first="${f#"$dir"}"
						fi
					done
					if [[ $bad -eq 0 ]]; then
						checks+=("$(verify_check php_syntax true "${#php_files[@]} random PHP files parse")")
					else
						checks+=("$(verify_check php_syntax warn "$bad of ${#php_files[@]} PHP files do not parse (first: $first); this can also be the live code")")
					fi
				fi
			fi
			local wpc
			wpc="$(find "$dir" -maxdepth 6 -name wp-config.php -type f -print -quit 2>/dev/null)"
			if [[ -n "$wpc" ]]; then
				if grep -q "DB_NAME" "$wpc"; then
					checks+=("$(verify_check wordpress true "wp-config.php present and readable")")
				else
					checks+=("$(verify_check wordpress false "wp-config.php has no database settings")")
				fi
			fi
			;;
		mail:*)
			local msgs
			msgs="$(find "$dir" -type f \( -path '*/cur/*' -o -path '*/new/*' \) | wc -l)"
			checks+=("$(verify_check mailboxes true "$msgs messages restored")")
			;;
		system)
			local p missing="" paths
			paths="$(r snapshots --json "$id" 2>/dev/null | jq -c '.[0].paths // []')" || paths="[]"
			for p in /etc/webhosting-panel /etc/nginx; do
				if jq -e --arg p "$p" 'any(.[]; . == $p)' <<<"$paths" >/dev/null && [[ ! -d "$dir$p" ]]; then
					missing+=" $p"
				fi
			done
			if [[ -z "$missing" ]]; then
				checks+=("$(verify_check configuration true "server configuration folders present")")
			else
				checks+=("$(verify_check configuration false "missing:$missing")")
			fi
			;;
	esac
	rm -rf --one-file-system "$dir"
	printf '%s\n' "${checks[@]}" | jq -cs --argjson f "$afiles" --argjson b "$abytes" '{checks:., files:$f, bytes:$b}'
}

# Restore one database dump and import it into the private instance.
verify_database() {
	local id="$1" db="$2" dir="$3"
	local -a checks=()
	mkdir -p "$dir"
	chmod 700 "$dir"
	local dumpfile="$dir/$db.sql"
	if ! r dump "$id" "/databases/$db.sql" >"$dumpfile" 2>>"$STATE_DIR/restic.err"; then
		checks+=("$(verify_check restore false "could not read the dump: $(tail -n1 "$STATE_DIR/restic.err")")")
		rm -rf "$dir"
		printf '%s\n' "${checks[@]}" | jq -cs '{checks:., bytes:null, tables:null}'
		return
	fi
	local bytes
	bytes="$(stat -c %s "$dumpfile")"
	checks+=("$(verify_check restore true "dump downloaded and decrypted ($bytes bytes)")")
	local tail_line
	tail_line="$(tail -c 4096 "$dumpfile" | grep -a -- '-- Dump completed' | tail -n1 || true)"
	if [[ -n "$tail_line" ]]; then
		checks+=("$(verify_check dump_complete true "${tail_line#-- }")")
	else
		checks+=("$(verify_check dump_complete false "the dump has no end marker: it was cut off while it was made")")
	fi
	local etables
	etables="$(grep -a -c '^CREATE TABLE ' "$dumpfile" || true)"

	local tables="null"
	if [[ $VERIFY_DB_READY -eq 1 ]]; then
		local err="$dir/import.err"
		if verify_sql -e "CREATE DATABASE \`whp_restore_test\` CHARACTER SET utf8mb4" 2>"$err" \
			&& verify_sql whp_restore_test <"$dumpfile" 2>"$err"; then
			tables="$(verify_sql -e "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='whp_restore_test' AND TABLE_TYPE='BASE TABLE'")"
			local rows
			rows="$(verify_sql -e "SELECT COALESCE(SUM(TABLE_ROWS),0) FROM information_schema.TABLES WHERE TABLE_SCHEMA='whp_restore_test'")"
			if [[ "$tables" == "$etables" ]]; then
				checks+=("$(verify_check import true "imported in a private test database: $tables tables, about $rows rows")")
			else
				checks+=("$(verify_check import false "imported $tables of $etables tables")")
			fi
			local bad
			bad="$(mariadb-check --no-defaults --socket="$VERIFY_DB_DIR/mysqld.sock" -uroot --check --silent whp_restore_test 2>&1 \
				| grep -v -E '^\s*$|\sOK$|^note|^status' | head -n3 || true)"
			if [[ -z "$bad" ]]; then
				checks+=("$(verify_check tables true "every table passes CHECK TABLE")")
			else
				checks+=("$(verify_check tables false "$(tr '\n' ' ' <<<"$bad")")")
			fi
		else
			checks+=("$(verify_check import false "import failed: $(tail -n1 "$err" | cut -c1-300)")")
		fi
		verify_sql -e "DROP DATABASE IF EXISTS \`whp_restore_test\`" >/dev/null 2>&1 || true
	else
		checks+=("$(verify_check import warn "no private MariaDB instance available here; only the dump file was checked")")
	fi
	rm -rf --one-file-system "$dir"
	printf '%s\n' "${checks[@]}" | jq -cs --argjson b "$bytes" --argjson t "$tables" '{checks:., bytes:$b, tables:$t}'
}

verify_item() {
	# Test one snapshot. Args: target, snapshot meta JSON, reason (latest|latest_full)
	local meta="$1" reason="$2"
	local id scope short started took res status
	id="$(jq -r .id <<<"$meta")"
	short="${id:0:8}"
	scope="$(jq -r .scope <<<"$meta")"
	started="$(date +%s%N)"
	log info "restore test of $scope (${short}, $(jq -r .kind <<<"$meta"))"
	case "$scope" in
		db:*) res="$(verify_database "$id" "${scope#db:}" "$VERIFY_RUN_DIR/$short")" ;;
		*) res="$(verify_files "$id" "$scope" "$VERIFY_RUN_DIR/$short")" ;;
	esac
	took=$(( ($(date +%s%N) - started) / 1000000 ))
	if jq -e '.skipped' <<<"$res" >/dev/null 2>&1; then
		status="skipped"
	elif jq -e 'any(.checks[]; .result == "failed")' <<<"$res" >/dev/null; then
		status="failed"
	elif jq -e 'any(.checks[]; .result == "warning")' <<<"$res" >/dev/null; then
		status="warning"
	else
		status="ok"
	fi
	jq -c --argjson meta "$meta" --arg st "$status" --arg why "$reason" --argjson ms "$took" \
		--argjson now "$(date +%s)" \
		"$JQ_EPOCH"'{scope:$meta.scope, snapshot:$meta.id, short_id:$meta.short_id, kind:$meta.kind, time:$meta.time,
		  age_hours: ((($now - ($meta.time | epoch)) / 3600) | floor),
		  picked:$why, status:$st, duration_ms:$ms} + .' <<<"$res"
}

# Choose which items get a restore test: the ones tested longest ago first,
# so over a few runs every website, mailbox and database is covered.
verify_pick() {
	local target="$1" category="$2" count="$3" candidates="$4"
	[[ "$count" =~ ^[0-9]+$ && "$count" -gt 0 ]] || return 0
	local hist="$STATE_DIR/verify-history.json"
	jq -r --arg t "$target" --arg c "$category" --slurpfile h "$hist" '
		[.[] | select(if $c == "system" then . == "system" else startswith($c + ":") end)]
		| map({s: ., last: ($h[0][$t + "|" + .] // 0)})
		| sort_by(.last, (.s | explode | add)) | .[].s' <<<"$candidates" | head -n "$count"
}

verify_target() {
	local target="$1" kinds="$2" max_age="$3"; shift 3
	local -a explicit=("$@")
	load_target "$target"
	local started
	started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	local snaps
	if ! snaps="$(snapshots_json --tag whp --host "${CFG[BACKUP_HOST]}")"; then
		jq -cn --arg t "$target" --arg s "$started" --arg err "$(tail -n1 "$STATE_DIR/restic.err" 2>/dev/null)" \
			'{target:$t, status:"failed", started:$s, finished:$s, error:("cannot read the backups on this location: " + $err), items:[], coverage:null}'
		return
	fi
	snaps="$(jq -c '[.[] | select(.kind == "full" or .kind == "incremental")]' <<<"$snaps")"

	# Coverage: does everything that lives on this server have a recent backup?
	local live with_backup coverage
	if [[ ${#explicit[@]} -gt 0 ]]; then
		live="$(expand_scopes "${explicit[@]}" | jq -R . | jq -cs .)"
	else
		live="$(expand_scopes all | jq -R . | jq -cs .)"
	fi
	coverage="$(jq -c --argjson snaps "$snaps" --argjson max "$max_age" --argjson now "$(date +%s)" "$JQ_EPOCH"'
		. as $live
		| ($snaps | group_by(.scope) | map({key: .[0].scope, value: (map(.time | epoch) | max)}) | from_entries) as $newest
		| {items: ($live | length),
		   with_backup: ([$live[] | select($newest[.] != null)] | length),
		   missing: [$live[] | select($newest[.] == null)],
		   stale: [$live[] | select($newest[.] != null and ($max > 0) and (($now - $newest[.]) / 3600) > $max)
		           | {scope: ., age_hours: ((($now - $newest[.]) / 3600) | floor)}]}' <<<"$live")"

	local candidates
	candidates="$(jq -c --argjson snaps "$snaps" '[.[] | select(. as $s | any($snaps[]; .scope == $s))]' <<<"$live")"
	local -a picked=()
	if [[ ${#explicit[@]} -gt 0 ]]; then
		mapfile -t picked < <(jq -r '.[]' <<<"$candidates")
	else
		[[ "${VERIFY_COUNT[system]}" == "yes" ]] && mapfile -t -O "${#picked[@]}" picked < <(verify_pick "$target" system 1 "$candidates")
		mapfile -t -O "${#picked[@]}" picked < <(verify_pick "$target" site "${VERIFY_COUNT[sites]}" "$candidates")
		mapfile -t -O "${#picked[@]}" picked < <(verify_pick "$target" mail "${VERIFY_COUNT[mail]}" "$candidates")
		mapfile -t -O "${#picked[@]}" picked < <(verify_pick "$target" db "${VERIFY_COUNT[databases]}" "$candidates")
	fi

	local tested="[]" scope latest full res
	for scope in "${picked[@]}"; do
		[[ -n "$scope" ]] || continue
		latest="$(jq -c --arg s "$scope" '[.[] | select(.scope == $s)][0]' <<<"$snaps")"
		res="$(verify_item "$latest" latest)"
		tested="$(jq -c --argjson r "$res" '. + [$r]' <<<"$tested")"
		if [[ "$kinds" == "both" && "$(jq -r .kind <<<"$latest")" != "full" ]]; then
			full="$(jq -c --arg s "$scope" '[.[] | select(.scope == $s and .kind == "full")][0] // empty' <<<"$snaps")"
			if [[ -n "$full" ]]; then
				res="$(verify_item "$full" latest_full)"
				tested="$(jq -c --argjson r "$res" '. + [$r]' <<<"$tested")"
			fi
		fi
		# Remember when this item was tested (for the rotation).
		local hist="$STATE_DIR/verify-history.json"
		jq -c --arg k "$target|$scope" --argjson now "$(date +%s)" '.[$k] = $now' "$hist" >"$hist.tmp" && mv -f "$hist.tmp" "$hist"
	done

	local status
	status="$(jq -r --argjson cov "$coverage" '
		if any(.[]; .status == "failed") or ($cov.missing | length > 0) then "failed"
		elif any(.[]; .status == "warning" or .status == "skipped") or ($cov.stale | length > 0) then "warning"
		elif length == 0 then "warning"
		else "ok" end' <<<"$tested")"
	jq -cn --arg t "$target" --arg type "${TGT[TYPE]}" --arg st "$status" --arg s "$started" \
		--arg f "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson items "$tested" --argjson cov "$coverage" \
		'{target:$t, type:$type, status:$st, started:$s, finished:$f, items:$items, coverage:$cov}
		 + (if ($items | length) == 0 then {error:"no restore points to test on this location"} else {} end)'
}

declare -A VERIFY_COUNT=()

cmd_verify() {
	local target="" kinds="${CFG[VERIFY_KINDS]}" max_age="${CFG[VERIFY_MAX_AGE_HOURS]}"
	local -a scopes=()
	VERIFY_COUNT=([system]="${CFG[VERIFY_SYSTEM]}" [sites]="${CFG[VERIFY_SITES]}" [mail]="${CFG[VERIFY_MAIL]}" [databases]="${CFG[VERIFY_DATABASES]}")
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--target) target="$2"; shift 2 ;;
			--scope) scopes+=("$2"); shift 2 ;;
			--sites) VERIFY_COUNT[sites]="$2"; shift 2 ;;
			--mail) VERIFY_COUNT[mail]="$2"; shift 2 ;;
			--databases) VERIFY_COUNT[databases]="$2"; shift 2 ;;
			--no-system) VERIFY_COUNT[system]="no"; shift ;;
			--system) VERIFY_COUNT[system]="yes"; shift ;;
			--kinds) kinds="$2"; shift 2 ;;
			--max-age-hours) max_age="$2"; shift 2 ;;
			*) die invalid_params "unknown option for verify: $1" ;;
		esac
	done
	local n
	for n in sites mail databases; do
		[[ "${VERIFY_COUNT[$n]}" =~ ^[0-9]{1,4}$ ]] || die invalid_params "--$n must be a number"
	done
	[[ "$kinds" == "latest" || "$kinds" == "both" ]] || die invalid_params "--kinds must be latest or both"
	[[ "$max_age" =~ ^[0-9]{1,5}$ ]] || die invalid_params "--max-age-hours must be a number"
	[[ ${#scopes[@]} -eq 0 ]] || validate_scopes "${scopes[@]}"
	[[ -z "$target" ]] || valid_name "$target" || die invalid_params "invalid target name"
	[[ "${CFG[VERIFY_DIR]}" == /* && "${CFG[VERIFY_DIR]}" != *..* ]] || die config_error "VERIFY_DIR must be an absolute path"

	take_lock
	# A restore test may take a while; live websites always go first.
	renice -n 15 -p $$ >/dev/null 2>&1 || true
	ionice -c 3 -p $$ >/dev/null 2>&1 || true
	mkdir -p "$STATE_DIR"
	: >"$STATE_DIR/restic.err"
	install -d -m 711 "${CFG[VERIFY_DIR]}"
	[[ -f "$STATE_DIR/verify-history.json" ]] || echo '{}' >"$STATE_DIR/verify-history.json"
	# Leftovers of an interrupted test (the lock guarantees none is running).
	local old
	for old in "${CFG[VERIFY_DIR]}"/run-*; do rm -rf --one-file-system "$old"; done
	VERIFY_RUN_DIR="$(mktemp -d "${CFG[VERIFY_DIR]}/run-XXXXXX")"
	chmod 711 "$VERIFY_RUN_DIR"
	trap verify_cleanup EXIT

	local -a targets=()
	if [[ -n "$target" ]]; then
		load_target "$target"
		targets=("$target")
	else
		local t
		while IFS= read -r t; do
			load_target "$t"
			[[ "${TGT[ENABLED]}" == "yes" ]] && targets+=("$t")
		done < <(all_targets)
	fi
	[[ ${#targets[@]} -gt 0 ]] || die not_found "no backup targets configured"

	# Databases to test? Then start the private MariaDB instance now.
	local want_db=0 sc
	for sc in "${scopes[@]}"; do [[ "$sc" == db:* || "$sc" == databases || "$sc" == all ]] && want_db=1; done
	if [[ ${#scopes[@]} -eq 0 && "${VERIFY_COUNT[databases]}" != "0" ]]; then
		local dbs
		dbs="$(list_databases)"
		[[ -z "$dbs" ]] || want_db=1
	fi
	if [[ $want_db -eq 1 ]]; then verify_db_start || true; fi

	local started runs="[]" t res
	started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	for t in "${targets[@]}"; do
		log info "target $t: restore test"
		res="$(verify_target "$t" "$kinds" "$max_age" "${scopes[@]}")"
		log info "target $t: restore test $(jq -r .status <<<"$res")"
		runs="$(jq -c --argjson r "$res" '. + [$r]' <<<"$runs")"
	done
	verify_cleanup
	trap - EXIT
	local status doc
	status="$(jq -r 'if any(.[]; .status == "failed") then "failed" elif any(.[]; .status == "warning") then "warning" else "ok" end' <<<"$runs")"
	doc="$(jq -n --arg st "$status" --arg s "$started" --arg f "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
		--arg host "${CFG[BACKUP_HOST]}" --arg kinds "$kinds" --argjson runs "$runs" \
		'{status:$st, host:$host, kinds:$kinds, started:$s, finished:$f, sandbox_removed:true, targets:$runs}')"
	printf '%s\n' "$doc" >"$STATE_DIR/verify-last.json.tmp" && mv -f "$STATE_DIR/verify-last.json.tmp" "$STATE_DIR/verify-last.json"
	if [[ $JSON -eq 1 ]]; then
		emit "$doc"
	else
		jq -r '"restore test \(.status) (\(.started) - \(.finished))",
			(.targets[] | .target as $t | (.items[] | "  \($t)  \(.scope)  \(.short_id)  \(.kind)  \(.status)"),
			 (.coverage.missing[]? | "  \($t)  \(.)  NO BACKUP"),
			 (.coverage.stale[]? | "  \($t)  \(.scope)  last backup \(.age_hours) h ago"))' <<<"$doc"
	fi
	[[ "$status" != "failed" ]]
}

# ----------------------------------------------------------------------------
# maintenance
# ----------------------------------------------------------------------------

forget_target() {
	local -a keep=()
	local k flag
	for k in LAST DAILY WEEKLY MONTHLY YEARLY; do
		flag="--keep-${k,,}"
		[[ "${TGT[KEEP_$k]}" =~ ^[0-9]+$ && "${TGT[KEEP_$k]}" != "0" ]] && keep+=("$flag" "${TGT[KEEP_$k]}")
	done
	[[ ${#keep[@]} -gt 0 ]] || { log warn "no retention configured, nothing forgotten"; return 0; }
	r forget --tag whp --group-by host,paths "${keep[@]}" --prune --json
}

cmd_prune() {
	local target=""
	[[ "${1:-}" == "--target" ]] && target="${2:-}"
	[[ -n "$target" ]] || die invalid_params "--target is required"
	load_target "$target"
	take_lock
	local out
	out="$(forget_target)" || die repo_error "forget/prune failed on target $target"
	emit "$(jq -n --arg t "$target" --argjson removed "$(jq -s '[.[]? | .[]? | .remove // [] | length] | add // 0' <<<"$out" 2>/dev/null || echo 0)" \
		'{target:$t, snapshots_removed:$removed}')"
}

cmd_check() {
	local target="" read_data=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--target) target="$2"; shift 2 ;;
			--read-data) read_data=1; shift ;;
			*) die invalid_params "unknown option for check: $1" ;;
		esac
	done
	[[ -n "$target" ]] || die invalid_params "--target is required"
	load_target "$target"
	take_lock
	local -a a=()
	[[ $read_data -eq 1 ]] && a+=(--read-data-subset "${CFG[CHECK_READ_DATA_SUBSET]}")
	local ok="true" out
	out="$(r check "${a[@]}" 2>&1)" || ok="false"
	emit "$(jq -n --arg t "$target" --argjson ok "$ok" --arg out "$(tail -n5 <<<"$out")" '{target:$t, healthy:$ok, output:$out}')"
	[[ "$ok" == "true" ]]
}

cmd_unlock() {
	local target="${2:-}"
	[[ "${1:-}" == "--target" && -n "$target" ]] || die invalid_params "--target is required"
	load_target "$target"
	r unlock >/dev/null
	emit "$(jq -n --arg t "$target" '{target:$t, unlocked:true}')"
}

cmd_status() {
	local last="null"
	[[ -f "$STATE_DIR/last-run.json" ]] && last="$(cat "$STATE_DIR/last-run.json")"
	local tlist="[]" t
	while IFS= read -r t; do
		tlist="$(jq --argjson t "$(target_json "$t")" '. + [$t]' <<<"$tlist")"
	done < <(all_targets)
	local running="false"
	if [[ -e "$LOCK_FILE" ]] && ! flock -n "$LOCK_FILE" true 2>/dev/null; then running="true"; fi
	local doc
	doc="$(jq -n --arg v "$WHP_BACKUP_VERSION" --argjson last "$last" --argjson targets "$tlist" \
		--argjson running "$running" --arg restic "$(restic version 2>/dev/null | awk '{print $2}')" \
		--arg rclone "$(rclone version 2>/dev/null | awk 'NR==1{print $2}')" \
		'{version:$v, restic:$restic, rclone:$rclone, running:$running, targets:$targets, last_run:$last}')"
	emit "$doc"
}

usage() {
	cat <<'EOF'
whp-backup - backups for Webhosting Panel (restic + rclone)

Usage: whp-backup [--json] [--quiet] <command> [options]

Targets (each target is one encrypted restic repository):
  target add --name N --type sftp|scp|ftp|ftps|onedrive|local --path P [options]
      --host H --port P --user U --password-file F     connection
      --ssh-key F --known-hosts F                     sftp/scp (host key is pinned)
      --tls explicit|implicit                         ftps (default explicit)
      --allow-plain-ftp                               allow unencrypted ftp
      --onedrive-token-file F                         JSON from `rclone authorize onedrive`
      --onedrive-drive-id ID --onedrive-drive-type personal|business|documentLibrary
      --repo-key-file F    connect to an EXISTING repository (disaster recovery)
      --update             replace the settings of an existing target
  target list | show N | test N | remove N | export-key N

Backups:
  run [--full|--incremental] [--target N] [--scope S]... [--prune]
      scopes: all (default), system, sites, mail, databases,
              site:<domain>, mail:<domain>, db:<name>
  snapshots --target N [--scope S] [--host H]
  restore --target N --snapshot ID (--to DIR | --in-place) [--include PATH] [--database NAME]
  prune --target N            apply retention and free space
  check --target N [--read-data]
  verify [--target N] [--scope S]... [--sites N] [--mail N] [--databases N]
         [--no-system] [--kinds latest|both] [--max-age-hours H]
      restore test: restores a sample of the newest restore points (and the
      newest full one) into an isolated scratch folder and a private MariaDB
      instance, checks them and removes everything again
  unlock --target N
  status
  version
EOF
}

main() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--json) JSON=1; QUIET=1; shift ;;
			--quiet) QUIET=1; shift ;;
			*) break ;;
		esac
	done
	local command="${1:-help}"; shift || true
	case "$command" in
		help|-h|--help) usage; return 0 ;;
		version|--version)
			if [[ $JSON -eq 1 ]]; then emit "$(jq -n --arg v "$WHP_BACKUP_VERSION" '{version:$v}')"; else echo "$WHP_BACKUP_VERSION"; fi
			return 0 ;;
	esac
	need restic rclone jq flock
	umask 077
	mkdir -p "$TARGETS_DIR" "$STATE_DIR"
	load_config
	case "$command" in
		target) cmd_target "$@" ;;
		run) cmd_run "$@" ;;
		snapshots) cmd_snapshots "$@" ;;
		restore) cmd_restore "$@" ;;
		prune) cmd_prune "$@" ;;
		check) cmd_check "$@" ;;
		verify) cmd_verify "$@" ;;
		unlock) cmd_unlock "$@" ;;
		status) cmd_status ;;
		*) usage >&2; die invalid_params "unknown command: $command" ;;
	esac
}

main "$@"
