{
    "name": "rhis/backups",
    "description": "Backup screens for the Webhosting Panel (admin and client), on top of whp-backup through the agent.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Rhis\\Backups\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rhis\\Backups\\BackupsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
