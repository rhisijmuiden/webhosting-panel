{
    "name": "rhis/files",
    "description": "Client file manager for the Webhosting Panel: browse, upload, download, zip/unzip, a code editor and an optional sandboxed web terminal.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Rhis\\Files\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rhis\\Files\\FilesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
