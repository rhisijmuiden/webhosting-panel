{
    "name": "rhis/dns-mail",
    "description": "Cloudflare DNS sync, per-domain mail routing (RHIS mail or Microsoft 365) and SnappyMail webmail config for the Webhosting Panel.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Rhis\\DnsMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rhis\\DnsMail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rhis\\DnsMail\\Laravel\\DnsMailServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
