{
    "name": "rhis/migration",
    "description": "Server migration for the Webhosting Panel: move websites, databases, mailboxes, certificates and DNS from a Plesk server.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Rhis\\Migration\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rhis\\Migration\\MigrationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
